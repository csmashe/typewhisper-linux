<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TypeWhisper.Core</RootNamespace>
        <AssemblyName>TypeWhisper.Core</AssemblyName>
        <!-- Required by the LibraryImport source generator (AtomicFileWrite's link(2) P/Invoke). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Test hooks and Linux's injected persistence writers use internal constructors. -->
        <InternalsVisibleTo Include="TypeWhisper.Core.Tests"/>
        <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests"/>
        <InternalsVisibleTo Include="typewhisper"/>
    </ItemGroup>
</Project>
