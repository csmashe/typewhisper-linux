<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TypeWhisper.Core</RootNamespace>
        <AssemblyName>TypeWhisper.Core</AssemblyName>
        <!-- Required by the LibraryImport source generator (AtomicFileWrite's link(2) P/Invoke). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exposes internal AvailableModels to the translation-target guard test. -->
        <InternalsVisibleTo Include="TypeWhisper.Core.Tests"/>
    </ItemGroup>
</Project>
