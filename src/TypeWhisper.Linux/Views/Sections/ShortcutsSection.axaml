<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.ShortcutsSection"
             Focusable="True"
             x:DataType="vm:ShortcutsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.section-panel">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style Selector="Border.section-row">
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.row-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="860">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{loc:Str Shortcuts.Title}"
                           Classes="page-title" />
                <TextBlock
                    Text="{loc:Str Shortcuts.Subtitle}"
                    Classes="page-subtitle" />
                <TextBlock
                    Text="{loc:Str Shortcuts.ComboHint}"
                    FontSize="11"
                    Foreground="{DynamicResource TwTextBodyBrush}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="{loc:Str Shortcuts.Status}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <StackPanel>
                    <Border Classes="section-row">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.Backend}" Classes="row-title" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding ActiveBackendDisplayName, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Shortcuts.StatusActive}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding SessionType, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Shortcuts.StatusDisplayServer}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding ScopeText, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Shortcuts.StatusCaptureScope}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding SupportsPressReleaseText, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Shortcuts.StatusPressRelease}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource TwFillSubtleBrush}" Margin="18,0"
                            IsVisible="{Binding ShowStaleIntegrationBanner}" />

                    <Border Classes="section-row"
                            Background="{DynamicResource TwWarningSubtleBrush}"
                            BorderBrush="{DynamicResource TwWarningBorderBrush}"
                            BorderThickness="0,1"
                            IsVisible="{Binding ShowStaleIntegrationBanner}">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.DesktopIntegrationStale}"
                                       Classes="row-title"
                                       Foreground="{DynamicResource TwWarningTextBrush}" />
                            <TextBlock Text="{Binding StaleIntegrationMessage}"
                                       Classes="row-hint"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,10,0,0">
                                <Button Content="{Binding SetupAutomaticallyLabel}"
                                        Command="{Binding SetupAutomaticallyCommand}"
                                        IsVisible="{Binding CanRefreshDesktopIntegration}" />
                                <Button Content="{loc:Str Common.RemoveIntegration}"
                                        Command="{Binding RemoveIntegrationCommand}"
                                        IsEnabled="{Binding CanRemoveDesktopIntegration}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource TwFillSubtleBrush}" Margin="18,0"
                            IsVisible="{Binding ShowKeyboardAccessBanner}" />

                    <Border Classes="section-row"
                            IsVisible="{Binding ShowKeyboardAccessBanner}">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.KeyboardAccessBanner}"
                                       Classes="row-title"
                                       Foreground="{DynamicResource TwWarningTextBrush}" />
                            <TextBlock TextWrapping="Wrap"
                                       Classes="row-hint"
                                       Text="{loc:Str Shortcuts.KeyboardAccessBannerHint}" />
                            <Border Background="{DynamicResource TwSurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,8,0,0">
                                <SelectableTextBlock Text="{Binding KeyboardAccessCommand}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource TwFillSubtleBrush}" Margin="18,0"
                            IsVisible="{Binding ShowCapabilityMismatch}" />

                    <Border Classes="section-row"
                            IsVisible="{Binding ShowCapabilityMismatch}">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.CapabilityMismatch}"
                                       Classes="row-title"
                                       Foreground="{DynamicResource TwWarningTextBrush}" />
                            <TextBlock TextWrapping="Wrap"
                                       Classes="row-hint"
                                       Text="{loc:Str Shortcuts.CapabilityMismatchHint}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{DynamicResource TwFillSubtleBrush}" Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.WaylandEvdev}"
                                           Classes="row-title" />
                                <TextBlock TextWrapping="Wrap"
                                           Classes="row-hint"
                                           Text="{loc:Str Shortcuts.WaylandEvdevHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Shortcuts.WaylandEvdev}"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding WaylandEvdevHotkeysEnabled}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.MainCapture}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <StackPanel>
                    <Border Classes="section-row">
                        <!-- Title above the controls: the record, cancel, and apply buttons are too wide
                             for a side-by-side row in compact windows and long translations. -->
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="10">
                            <StackPanel>
                                <TextBlock Text="{loc:Str Shortcuts.MainHotkey}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.MainHotkeyHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <WrapPanel Grid.Row="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Left">
                                <TextBox Width="240"
                                         Margin="0,0,8,8"
                                         AutomationProperties.Name="{loc:Str Shortcuts.MainHotkey}"
                                         Text="{Binding HotkeyText}"
                                         PlaceholderText="Ctrl+Shift+Space" />
                                <Button Content="{loc:Str Shortcuts.RecordShortcut}"
                                        Margin="0,0,8,8"
                                        Click="OnStartHotkeyCaptureClick"
                                        IsEnabled="{Binding CanStartHotkeyCapture}"
                                        IsVisible="{Binding !IsCapturingHotkey}" />
                                <Button Content="{loc:Str Shortcuts.CancelCapture}"
                                        Margin="0,0,8,8"
                                        Command="{Binding CancelHotkeyCaptureCommand}"
                                        IsVisible="{Binding IsCapturingHotkey}" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Margin="0,0,8,8"
                                        Command="{Binding ApplyHotkeyCommand}"
                                        IsVisible="{Binding !IsCapturingHotkey}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{loc:Str Shortcuts.CapturePrompt}"
                               Classes="row-hint"
                               Margin="18,0,18,14"
                               IsVisible="{Binding IsCapturingHotkey}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.MoreShortcuts}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <StackPanel>
                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.ActivationMode}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.ActivationModeHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="14"
                                        VerticalAlignment="Center">
                                <RadioButton Content="{loc:Str Common.ModeToggle}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.Toggle}}" />
                                <RadioButton Content="{loc:Str Common.ModePushToTalk}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.PushToTalk}}" />
                                <RadioButton Content="{loc:Str Common.ModeHybrid}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.Hybrid}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.PromptPalette}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.PromptPaletteHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.PromptPalette}"
                                         Text="{Binding PromptPaletteHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+P" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyPromptPaletteHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.TransformSelection}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.TransformSelectionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.TransformSelection}"
                                         Text="{Binding TransformSelectionHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+T" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyTransformSelectionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.RecentTranscriptions}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.RecentTranscriptionsHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.RecentTranscriptions}"
                                         Text="{Binding RecentTranscriptionsHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+R" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyRecentTranscriptionsHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.CopyLastTranscription}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.CopyLastTranscriptionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.CopyLastTranscription}"
                                         Text="{Binding CopyLastTranscriptionHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+C" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyCopyLastTranscriptionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.ReadLastTranscription}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.ReadLastTranscriptionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.ReadLastTranscription}"
                                         Text="{Binding ReadLastTranscriptionHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+S" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyReadLastTranscriptionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource TwFillSubtleBrush}"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.PasteLastTranscription}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.PasteLastTranscriptionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         AutomationProperties.Name="{loc:Str Shortcuts.PasteLastTranscription}"
                                         Text="{Binding PasteLastTranscriptionHotkeyText}"
                                         PlaceholderText="Ctrl+Alt+V" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyPasteLastTranscriptionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.BindCustom}"
                       Classes="section-label" />
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TwTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="{loc:Str Shortcuts.CompositorBindsNote}" />
            <Button HorizontalAlignment="Left"
                    Margin="0,0,0,10"
                    Content="{Binding CompositorBindsToggleLabel}"
                    Command="{Binding ToggleCompositorBindsCommand}" />
            <Border Classes="section-panel"
                    IsVisible="{Binding CompositorBindsExpanded}">
                <Border Classes="section-row">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding CanSetupAutomatically}"
                                    Margin="0,0,0,16">
                            <TextBlock Classes="row-title"
                                       Text="{Binding SetupAutomaticallyLabel}" />
                            <TextBlock Margin="0,4,0,0"
                                       Classes="row-hint"
                                       TextWrapping="Wrap"
                                       Text="{loc:Str Shortcuts.AutoSetupHint}" />

                            <Border Background="{DynamicResource TwSurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,8,0,0">
                                <SelectableTextBlock Text="{Binding IntegrationPreview}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12"
                                                     TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,10,0,0">
                                <Button Content="{Binding SetupAutomaticallyLabel}"
                                        Command="{Binding SetupAutomaticallyCommand}"
                                        IsVisible="{Binding CanWriteDesktopIntegration}" />
                                <Button Content="{loc:Str Common.RemoveIntegration}"
                                        Command="{Binding RemoveIntegrationCommand}" />
                            </StackPanel>

                            <Border Background="{DynamicResource TwSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,10,0,0"
                                    IsVisible="{Binding IntegrationStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding IntegrationStatusMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TwTextBodyBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource TwFillSubtleBrush}"
                                    Margin="0,16,0,0" />
                        </StackPanel>

                        <TextBlock Classes="row-title"
                                   Text="{loc:Str Shortcuts.ShowCommands}"
                                   IsVisible="{Binding CanSetupAutomatically}"
                                   Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap"
                                   Classes="row-hint"
                                   Margin="0,0,0,10"
                                   Text="{loc:Str Shortcuts.ShowCommandsHint}" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource TwSurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <SelectableTextBlock Text="{Binding CustomShortcutCommand}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="{loc:Str Common.Copy}"
                                    Command="{Binding CopyCustomShortcutCommand}" />
                        </Grid>

                        <StackPanel Margin="0,14,0,0"
                                    IsVisible="{Binding ShowPushToTalkSnippet}">
                            <TextBlock Classes="row-hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding PushToTalkSnippetHint}" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,0">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource TwSurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                    <SelectableTextBlock Text="{Binding PushToTalkPressSnippet}"
                                                         FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                         FontSize="12" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Common.Copy}"
                                        Command="{Binding CopyPushToTalkPressSnippetCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,6,0,0">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource TwSurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                    <SelectableTextBlock Text="{Binding PushToTalkReleaseSnippet}"
                                                         FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                         FontSize="12" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Common.Copy}"
                                        Command="{Binding CopyPushToTalkReleaseSnippetCommand}" />
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="{loc:Str Shortcuts.CopyBothLines}"
                                    Command="{Binding CopyPushToTalkPairCommand}" />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0"
                                   Classes="row-hint"
                                   Text="{Binding DesktopName, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Shortcuts.DetectedDesktop}" />
                        <TextBlock Margin="0,4,0,0"
                                   Classes="row-hint"
                                   TextWrapping="Wrap"
                                   Text="{Binding DesktopInstructions}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TwTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Str Shortcuts.AlreadyRunningHint}" />
                    </StackPanel>
                </Border>
            </Border>

            <Border Background="{DynamicResource TwSurfaceAltBrush}"
                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource TwTextBodyBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
