<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.ShortcutsSection"
             x:DataType="vm:ShortcutsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.section-panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style Selector="Border.section-row">
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#8A9AAE" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7D8796" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.row-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A9AAE" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="860">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{loc:Str Shortcuts.Title}"
                           Classes="page-title" />
                <TextBlock
                    Text="{loc:Str Shortcuts.Subtitle}"
                    Classes="page-subtitle" />
                <TextBlock
                    Text="{loc:Str Shortcuts.ComboHint}"
                    FontSize="11"
                    Foreground="#AFC0D3"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="{loc:Str Shortcuts.Status}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <StackPanel>
                    <Border Classes="section-row">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.Backend}" Classes="row-title" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding ActiveBackendDisplayName, StringFormat='Active: {0}'}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding SessionType, StringFormat='Display server: {0}'}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding ScopeText, StringFormat='Capture scope: {0}'}" />
                            <TextBlock Classes="row-hint"
                                       Text="{Binding SupportsPressRelease, StringFormat='Press/release support: {0}'}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#16FFFFFF" Margin="18,0"
                            IsVisible="{Binding ShowInputGroupBanner}" />

                    <Border Classes="section-row"
                            IsVisible="{Binding ShowInputGroupBanner}">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.InputGroupBanner}"
                                       Classes="row-title"
                                       Foreground="#FFD27A" />
                            <TextBlock TextWrapping="Wrap"
                                       Classes="row-hint"
                                       Text="{loc:Str Shortcuts.InputGroupBannerHint}" />
                            <Border Background="#0E1620"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,8,0,0">
                                <SelectableTextBlock Text="{Binding InputGroupCommand}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#16FFFFFF" Margin="18,0"
                            IsVisible="{Binding ShowCapabilityMismatch}" />

                    <Border Classes="section-row"
                            IsVisible="{Binding ShowCapabilityMismatch}">
                        <StackPanel>
                            <TextBlock Text="{loc:Str Shortcuts.CapabilityMismatch}"
                                       Classes="row-title"
                                       Foreground="#FFD27A" />
                            <TextBlock TextWrapping="Wrap"
                                       Classes="row-hint"
                                       Text="{loc:Str Shortcuts.CapabilityMismatchHint}" />
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="#16FFFFFF" Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.WaylandEvdev}"
                                           Classes="row-title" />
                                <TextBlock TextWrapping="Wrap"
                                           Classes="row-hint"
                                           Text="{loc:Str Shortcuts.WaylandEvdevHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding WaylandEvdevHotkeysEnabled}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.MainCapture}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <Border Classes="section-row">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:Str Shortcuts.MainHotkey}"
                                       Classes="row-title" />
                            <TextBlock
                                Text="{loc:Str Shortcuts.MainHotkeyHint}"
                                Classes="row-hint" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBox Width="240"
                                     Text="{Binding HotkeyText}"
                                     PlaceholderText="Ctrl+Shift+Space" />
                            <Button Content="{loc:Str Common.Apply}"
                                    Command="{Binding ApplyHotkeyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.MoreShortcuts}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <StackPanel>
                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.ActivationMode}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.ActivationModeHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="14"
                                        VerticalAlignment="Center">
                                <RadioButton Content="{loc:Str Common.ModeToggle}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.Toggle}}" />
                                <RadioButton Content="{loc:Str Common.ModePushToTalk}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.PushToTalk}}" />
                                <RadioButton Content="{loc:Str Common.ModeHybrid}"
                                             GroupName="mode"
                                             IsChecked="{Binding Mode, Mode=TwoWay,
                                                                 Converter={x:Static local:EnumBoolConverter.Instance},
                                                                 ConverterParameter={x:Static models:RecordingMode.Hybrid}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="#16FFFFFF"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.PromptPalette}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.PromptPaletteHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         Text="{Binding PromptPaletteHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+P" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyPromptPaletteHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="#16FFFFFF"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.TransformSelection}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.TransformSelectionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         Text="{Binding TransformSelectionHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+T" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyTransformSelectionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="#16FFFFFF"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.RecentTranscriptions}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.RecentTranscriptionsHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         Text="{Binding RecentTranscriptionsHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+R" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyRecentTranscriptionsHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1"
                            Background="#16FFFFFF"
                            Margin="18,0" />

                    <Border Classes="section-row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="16">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{loc:Str Shortcuts.CopyLastTranscription}"
                                           Classes="row-title" />
                                <TextBlock
                                    Text="{loc:Str Shortcuts.CopyLastTranscriptionHint}"
                                    Classes="row-hint" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBox Width="240"
                                         Text="{Binding CopyLastTranscriptionHotkeyText}"
                                         PlaceholderText="Ctrl+Shift+C" />
                                <Button Content="{loc:Str Common.Apply}"
                                        Command="{Binding ApplyCopyLastTranscriptionHotkeyCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:Str Shortcuts.BindCustom}"
                       Classes="section-label" />
            <Border Classes="section-panel">
                <Border Classes="section-row">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding CanSetupAutomatically}"
                                    Margin="0,0,0,16">
                            <TextBlock Classes="row-title"
                                       Text="{Binding SetupAutomaticallyLabel}" />
                            <TextBlock Margin="0,4,0,0"
                                       Classes="row-hint"
                                       TextWrapping="Wrap"
                                       Text="{loc:Str Shortcuts.AutoSetupHint}" />

                            <Border Background="#0E1620"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,8,0,0">
                                <SelectableTextBlock Text="{Binding IntegrationPreview}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12"
                                                     TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,10,0,0">
                                <Button Content="{Binding SetupAutomaticallyLabel}"
                                        Command="{Binding SetupAutomaticallyCommand}" />
                                <Button Content="{loc:Str Common.RemoveIntegration}"
                                        Command="{Binding RemoveIntegrationCommand}" />
                            </StackPanel>

                            <Border Background="#111822"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    Margin="0,10,0,0"
                                    IsVisible="{Binding IntegrationStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding IntegrationStatusMessage}"
                                           FontSize="12"
                                           Foreground="#AFC0D3"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Height="1"
                                    Background="#16FFFFFF"
                                    Margin="0,16,0,0" />
                        </StackPanel>

                        <TextBlock Classes="row-title"
                                   Text="{loc:Str Shortcuts.ShowCommands}"
                                   IsVisible="{Binding CanSetupAutomatically}"
                                   Margin="0,0,0,6" />
                        <TextBlock TextWrapping="Wrap"
                                   Classes="row-hint"
                                   Margin="0,0,0,10"
                                   Text="{loc:Str Shortcuts.ShowCommandsHint}" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Background="#0E1620"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6">
                                <SelectableTextBlock Text="{Binding CustomShortcutCommand}"
                                                     FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                     FontSize="12" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="{loc:Str Common.Copy}"
                                    Command="{Binding CopyCustomShortcutCommand}" />
                        </Grid>

                        <StackPanel Margin="0,14,0,0"
                                    IsVisible="{Binding ShowPushToTalkSnippet}">
                            <TextBlock Classes="row-hint"
                                       TextWrapping="Wrap"
                                       Text="{Binding PushToTalkSnippetHint}" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,0">
                                <Border Grid.Column="0"
                                        Background="#0E1620"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                    <SelectableTextBlock Text="{Binding PushToTalkPressSnippet}"
                                                         FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                         FontSize="12" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Common.Copy}"
                                        Command="{Binding CopyPushToTalkPressSnippetCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  Margin="0,6,0,0">
                                <Border Grid.Column="0"
                                        Background="#0E1620"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6">
                                    <SelectableTextBlock Text="{Binding PushToTalkReleaseSnippet}"
                                                         FontFamily="Cascadia Mono, JetBrains Mono, monospace"
                                                         FontSize="12" />
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{loc:Str Common.Copy}"
                                        Command="{Binding CopyPushToTalkReleaseSnippetCommand}" />
                            </Grid>

                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="{loc:Str Shortcuts.CopyBothLines}"
                                    Command="{Binding CopyPushToTalkPairCommand}" />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0"
                                   Classes="row-hint"
                                   Text="{Binding DesktopName, StringFormat='Detected desktop: {0}'}" />
                        <TextBlock Margin="0,4,0,0"
                                   Classes="row-hint"
                                   TextWrapping="Wrap"
                                   Text="{Binding DesktopInstructions}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="#7D8796"
                                   TextWrapping="Wrap"
                                   Text="{loc:Str Shortcuts.AlreadyRunningHint}" />
                    </StackPanel>
                </Border>
            </Border>

            <Border Background="#111822"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="#AFC0D3"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>