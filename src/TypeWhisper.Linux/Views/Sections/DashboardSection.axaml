<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:shellvm="using:TypeWhisper.Linux.ViewModels"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.DashboardSection"
             x:DataType="vm:DashboardSectionViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <StackPanel MaxWidth="860"
                        Margin="28"
                        Spacing="0">
                <StackPanel Spacing="8" Margin="0,0,0,20">
                    <TextBlock Text="{loc:Str Dashboard.Title}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Str Dashboard.Subtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    MaxWidth="860"
                    Margin="28,0,28,18"
                    Background="#18212C"
                    BorderBrush="#283644"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Str Dashboard.Statistics}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Dashboard.StatisticsHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <ToggleButton Content="{loc:Str Dashboard.RangeWeekly}"
                                      IsChecked="{Binding SelectedRange, Mode=OneWay,
                                                          ConverterParameter={x:Static vm:DashboardSectionViewModel+TimeRange.Weekly},
                                                          Converter={x:Static local:EnumBoolConverter.Instance}}"
                                      Command="{Binding ShowWeeklyCommand}" />
                        <ToggleButton Content="{loc:Str Dashboard.RangeMonth}"
                                      IsChecked="{Binding SelectedRange, Mode=OneWay,
                                                          ConverterParameter={x:Static vm:DashboardSectionViewModel+TimeRange.Month},
                                                          Converter={x:Static local:EnumBoolConverter.Instance}}"
                                      Command="{Binding ShowMonthCommand}" />
                        <ToggleButton Content="{loc:Str Dashboard.RangeAllTime}"
                                      IsChecked="{Binding SelectedRange, Mode=OneWay,
                                                          ConverterParameter={x:Static vm:DashboardSectionViewModel+TimeRange.AllTime},
                                                          Converter={x:Static local:EnumBoolConverter.Instance}}"
                                      Command="{Binding ShowAllTimeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2"
                         MaxWidth="860"
                         Margin="28,0,28,24"
                         Rows="1"
                         Columns="4">
                <Border Background="#1A2430"
                        BorderBrush="#2A3950"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,20"
                        Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="✍"
                                   FontSize="18"
                                   Foreground="#1593F5"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding WordCount}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Dashboard.Words}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#1A2430"
                        BorderBrush="#2A3950"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,20"
                        Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚡"
                                   FontSize="18"
                                   Foreground="#1593F5"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AverageWpm}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Dashboard.Wpm}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#1A2430"
                        BorderBrush="#2A3950"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,20"
                        Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⊞"
                                   FontSize="18"
                                   Foreground="#1593F5"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding AppCount}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Dashboard.Apps}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#1C2038"
                        BorderBrush="#2A3950"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏱"
                                   FontSize="18"
                                   Foreground="#1593F5"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TimeSavedLabel}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Str Dashboard.Saved}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="3"
                    MaxWidth="860"
                    Margin="28,0,28,24"
                    Background="#141B24"
                    BorderBrush="#283644"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Str Dashboard.Insights}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Border Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding AverageWordsPerDictationLabel}"
                                               FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.AvgWordsPerDictation}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding AverageDurationLabel}"
                                               FontSize="24"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.AvgDuration}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{loc:Str Dashboard.InsertionReliability}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">
                            <Border Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding InsertionSuccessRateLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Inserted}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding ClipboardFallbackCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.ClipboardFallback}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding PastedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InsertedBreakdownLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding FailedInsertionCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Failed}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="8">
                        <TextBlock Text="{loc:Str Dashboard.TopApps}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Dashboard.NoAppUsage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding !HasTopApps}" />
                        <ItemsControl ItemsSource="{Binding TopApps}"
                                      IsVisible="{Binding HasTopApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppUsageInsightRow">
                                    <Grid ColumnDefinitions="*,Auto"
                                          Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding AppProcessName}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Summary}"
                                                   FontSize="11"
                                                   Foreground="#9AA5B3"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Str Dashboard.WritingAssists}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">
                            <Border Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding CleanupAppliedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Cleanups}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SnippetAppliedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Snippets}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DictionaryCorrectionAppliedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Corrections}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding PromptActionAppliedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.PromptActions}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Background="#111822"
                                    BorderBrush="#243241"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding TranslationAppliedCountLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Str Dashboard.Translations}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4"
                       Text="{loc:Str Dashboard.Activity}"
                       MaxWidth="860"
                       Margin="28,0,28,12"
                       FontSize="16"
                       FontWeight="SemiBold" />

            <Border Grid.Row="5"
                    MaxWidth="860"
                    Margin="28,0,28,24"
                    Background="#141B24"
                    BorderBrush="#283644"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    MinHeight="220">
                <Grid>
                    <TextBlock Text="{loc:Str Dashboard.NoActivity}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding !HasRecentActivity}" />

                    <ItemsControl ItemsSource="{Binding RecentActivity}"
                                  IsVisible="{Binding HasRecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TranscriptionRecord">
                                <Border Padding="8,10"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#283644">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       FontSize="11"
                                                       Foreground="#9BB0C4" />
                                            <TextBlock Text="{Binding AppName}"
                                                       FontSize="11"
                                                       Foreground="#9BB0C4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Row="6"
                    MaxWidth="860"
                    Margin="28,0,28,28"
                    Background="#111822"
                    BorderBrush="#283644"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Walk up to the host Window to reach MainWindowViewModel,
                         because DashboardSectionViewModel doesn't hold a reference
                         to the shell VM. -->
                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                        <Button Content="{loc:Str Common.OpenWizard}"
                                Command="{Binding $parent[Window].((shellvm:MainWindowViewModel)DataContext).OpenWizardCommand}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock Text="{loc:Str Dashboard.SetupWizard}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Str Dashboard.SetupWizardHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>