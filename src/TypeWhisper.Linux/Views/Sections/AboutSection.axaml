<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.AboutSection"
             x:DataType="vm:AboutSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="980"
                    Spacing="18">
            <StackPanel HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="0,10,0,0">
                <TextBlock Text="TypeWhisper"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Str About.Tagline}"
                           FontSize="13.5"
                           Foreground="#9BAABC"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                           FontSize="12"
                           Foreground="#9BAABC"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button Content="{loc:Str About.CheckForUpdates}"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding CanCheckForUpdates}" />
                    <Button Content="{loc:Str About.Download}"
                            Command="{Binding OpenReleasePageCommand}"
                            IsVisible="{Binding UpdateAvailable}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatusText}"
                           FontSize="12"
                           Foreground="#8A9AAE"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,18" />
                <TextBlock Text="{loc:Str About.EnginesNote}"
                           FontSize="13"
                           Foreground="#B7C4D3"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Str About.License}"
                           FontSize="13"
                           Foreground="#B7C4D3"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Copyright}"
                           FontSize="12"
                           Foreground="#8A9AAE"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Copyright, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <Border Classes="panel"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">
                            <TextBlock Text="{loc:Str About.SettingsBackup}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ProgressBar Width="90"
                                         Height="4"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsBackupBusy}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BackupStatusText}"
                                   FontSize="12"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Str About.BackUp}"
                            IsEnabled="{Binding IsBackupBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"
                            VerticalAlignment="Center"
                            Click="OnBackupSettings" />
                    <Button Grid.Column="2"
                            Content="{loc:Str About.Restore}"
                            IsEnabled="{Binding IsBackupBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"
                            VerticalAlignment="Center"
                            Click="OnRestoreSettings" />
                </Grid>
            </Border>

            <Border Classes="panel"
                    Height="386">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="16,12"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="{loc:Str About.ErrorLog}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="150"
                                      ItemsSource="{Binding CategoryFilters}"
                                      SelectedItem="{Binding SelectedCategoryFilter}"
                                      IsVisible="{Binding HasErrors}"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="{loc:Str Common.Clear}"
                                    Command="{Binding ClearErrorsCommand}"
                                    IsVisible="{Binding HasErrors}" />
                            <Button Grid.Column="3"
                                    Content="{loc:Str About.ExportDiagnostics}"
                                    Click="OnExportDiagnostics" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasErrors, Converter={x:Static local:InverseBoolConverter.Instance}}">
                            <TextBlock Text="✓"
                                       FontSize="42"
                                       Foreground="#8DA0B8"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Str About.NoErrors}"
                                       FontSize="13"
                                       Foreground="#8A9AAE"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{loc:Str About.NoErrorsInCategory}"
                                   FontSize="13"
                                   Foreground="#8A9AAE"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowEmptyCategoryNotice}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding HasVisibleErrors}">
                            <ItemsControl ItemsSource="{Binding FilteredErrorEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ErrorLogEntryRow">
                                        <Border Padding="16,12"
                                                BorderBrush="#1AFFFFFF"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="10">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="11"
                                                               Foreground="#D6E7FF" />
                                                    <TextBlock Text="{Binding LocalTimestamp, StringFormat='{}{0:g}'}"
                                                               FontSize="11"
                                                               Foreground="#8A9AAE" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D7DEE8" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
