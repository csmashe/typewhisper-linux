<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:svc="using:TypeWhisper.Linux.Services"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.DictationSection"
             x:DataType="vm:DictationSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.settings-panel">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style Selector="TextBlock.group-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Padding" Value="18,12" />
        </Style>
        <Style Selector="Border.model-status.ready">
            <Setter Property="Background" Value="{DynamicResource TwSuccessFaintBrush}" />
        </Style>
        <Style Selector="Border.model-status-badge">
            <Setter Property="Background" Value="{DynamicResource TwFillSubtleBrush}" />
        </Style>
        <Style Selector="Border.model-status-badge.ready">
            <Setter Property="Background" Value="{DynamicResource TwSuccessSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.model-status-text">
            <Setter Property="Foreground" Value="{DynamicResource TwTextStrongBrush}" />
        </Style>
        <Style Selector="TextBlock.model-status-text.ready">
            <Setter Property="Foreground" Value="{DynamicResource TwSuccessTextBrush}" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.row-value">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.chip-remove">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.model-card">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="Border.model-card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource TwAccentBrush}" />
        </Style>
        <Style Selector="Border.model-card-badge">
            <Setter Property="Background" Value="{DynamicResource TwFillSubtleBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.model-card-badge.active">
            <Setter Property="Background" Value="{DynamicResource TwSuccessSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.model-card-badge-text">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextStrongBrush}" />
        </Style>
        <Style Selector="TextBlock.model-card-badge-text.active">
            <Setter Property="Foreground" Value="{DynamicResource TwSuccessTextBrush}" />
        </Style>
        <Style Selector="TextBlock.model-card-badge-text.failed">
            <Setter Property="Foreground" Value="{DynamicResource TwWarningTextBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,22,28,28"
                    MaxWidth="980">
            <TextBlock Text="{loc:Str Dictation.Engine}"
                       Classes="group-title" />
            <Border Classes="settings-panel">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <!-- The model list shrinks before the label in narrow windows and with long
                             translations of the delete button; it never grows past 320. -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="2*" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Str Dictation.DefaultModel}"
                                       Classes="row-label"
                                       TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.DefaultModel}"
                                      ItemsSource="{Binding ModelOptions}"
                                      SelectedItem="{Binding SelectedModel}"
                                      DropDownOpened="OnModelDropDownOpened"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DictationModelOption">
                                        <TextBlock Text="{Binding DisplayLabel}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="{loc:Str Dictation.DeleteModelFiles}"
                                    IsEnabled="{Binding CanDeleteSelectedModel}"
                                    Click="OnDeleteSelectedModel" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="2"
                            Classes="row">
                        <Grid ColumnDefinitions="*,240">
                            <TextBlock Text="{loc:Str Dictation.Engine}"
                                       Classes="row-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding EngineName}"
                                       Classes="row-value" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="4"
                            Classes="row model-status"
                            Classes.ready="{Binding ModelReady}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{loc:Str Dictation.ModelStatus}"
                                       Classes="row-label" />
                            <!-- Live progress bar while downloading; static status badge otherwise. -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="10"
                                        IsVisible="{Binding IsModelDownloading}">
                                <ProgressBar Width="220"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding ModelDownloadProgress}"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModelDownloadPercentText}"
                                           Classes="row-value"
                                           MinWidth="40"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    MaxWidth="760"
                                    CornerRadius="999"
                                    Padding="12,6"
                                    IsVisible="{Binding !IsModelDownloading}"
                                    Classes="model-status-badge"
                                    Classes.ready="{Binding ModelReady}">
                                <TextBlock Text="{Binding ModelStatusText}"
                                           Classes="row-value model-status-text"
                                           Classes.ready="{Binding ModelReady}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="6"
                            Classes="row">
                        <Grid ColumnDefinitions="*,320,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="{loc:Str Dictation.LocalModelAcceleration}"
                                       Classes="row-label" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.LocalModelAcceleration}"
                                      ItemsSource="{Binding AccelerationOptions}"
                                      SelectedItem="{Binding SelectedAccelerationOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccelerationOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="{Binding CudaLibraryPathActionText}"
                                    Command="{Binding AddCudaLibraryPathToShellProfileCommand}"
                                    IsVisible="{Binding ShowCudaLibraryPathAction}" />
                            <Button Grid.Column="2"
                                    Content="{Binding DownloadCudaRuntimeText}"
                                    Command="{Binding DownloadCudaRuntimeCommand}"
                                    IsVisible="{Binding ShowDownloadCudaRuntimeAction}" />
                            <Button Grid.Column="2"
                                    Content="{Binding ClearGpuRuntimeText}"
                                    Command="{Binding ClearGpuRuntimeCommand}"
                                    IsVisible="{Binding ShowClearGpuRuntimeAction}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="7"
                            BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="18,12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding AccelerationStatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TwTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CudaSetupStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TwWarningTextBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding CudaSetupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dictation.LocalModels}"
                       Classes="group-title"
                       IsVisible="{Binding HasLocalModelCards}" />
            <StackPanel Spacing="10"
                        Margin="0,0,0,18"
                        IsVisible="{Binding HasLocalModelCards}">
                <TextBlock Text="{loc:Str Dictation.LocalModelsDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource TwTextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding LocalModelCards}">
                    <!-- Hide the item container, not the card, so unlisted cards leave no spacing. A container
                         theme, unlike a style, doesn't also match the presenters inside the buttons. -->
                    <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter"
                                      x:DataType="vm:LocalModelCard">
                            <Setter Property="IsVisible" Value="{Binding IsListed}" />
                        </ControlTheme>
                    </ItemsControl.ItemContainerTheme>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocalModelCard">
                            <Border Classes="model-card"
                                    Classes.active="{Binding IsActive}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TwTextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Classes="model-card-badge"
                                                Classes.active="{Binding IsActive}">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       Classes="model-card-badge-text"
                                                       Classes.active="{Binding IsActive}"
                                                       Classes.failed="{Binding IsFailed}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding StateText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TwTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12"
                                          IsVisible="{Binding ShowProgress}">
                                        <ProgressBar Height="6"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Progress}"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="{loc:Str Dictation.ModelCardProgressName}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PercentText}"
                                                   FontSize="12"
                                                   MinWidth="36"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal"
                                               ItemSpacing="8"
                                               LineSpacing="8">
                                        <!-- ReSharper disable once Xaml.StyleClassNotFound, Xaml.PossibleNullReferenceException — 'accent' comes from FluentTheme, which the analyzer cannot see; the compiled-binding path is null-safe at runtime -->
                                        <Button Content="{loc:Str Dictation.ModelCardDownload}"
                                                Classes="accent"
                                                Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).DownloadLocalModelCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding ShowDownload}"
                                                IsEnabled="{Binding CanDownload}" />
                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                        <Button Content="{Binding UseText}"
                                                Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).UseLocalModelCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding ShowUse}"
                                                IsEnabled="{Binding CanUse}" />
                                        <Button Content="{loc:Str Dictation.ModelCardRemove}"
                                                Click="OnRemoveLocalModel"
                                                IsVisible="{Binding ShowRemove}"
                                                IsEnabled="{Binding CanRemove}" />
                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                        <Button Content="{loc:Str Dictation.ModelCardCancel}"
                                                Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).CancelLocalModelDownloadCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding ShowCancel}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{Binding LocalModelsToggleText}"
                        Command="{Binding ToggleLocalModelsCommand}"
                        IsVisible="{Binding ShowLocalModelsToggle}" />
            </StackPanel>

            <TextBlock Text="{loc:Str Dictation.ModelStorage}"
                       Classes="group-title" />
            <Border Classes="settings-panel">
                <Grid RowDefinitions="Auto,1,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{loc:Str Dictation.ModelStorageLocation}"
                                           Classes="row-label" />
                                <TextBlock Text="{Binding ModelStoragePath}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TwTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{loc:Str Dictation.ModelStorageChange}"
                                    Click="OnChangeModelStorage"
                                    IsEnabled="{Binding CanChangeModelStorage}" />
                            <Button Grid.Column="2"
                                    Content="{loc:Str Dictation.ModelStorageReset}"
                                    Command="{Binding ResetModelStorageCommand}"
                                    IsVisible="{Binding IsUsingCustomModelStorage}"
                                    IsEnabled="{Binding CanChangeModelStorage}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="2"
                            Classes="row"
                            IsVisible="{Binding ModelStorageStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ModelStorageStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TwTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dictation.Microphone}"
                       Classes="group-title" />
            <Border Classes="settings-panel">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <Grid ColumnDefinitions="*,320">
                            <TextBlock Text="{loc:Str Dictation.InputDevice}"
                                       Classes="row-label" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.InputDevice}"
                                      ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:AudioInputDevice">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="2"
                            Classes="row">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Content="{loc:Str Common.Refresh}"
                                    Command="{Binding RefreshDevicesCommand}" />
                            <ProgressBar Grid.Column="1"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding PreviewLevel}"
                                         Height="8"
                                         VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="4"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.MicTest}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.MicTestHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MicrophoneTestStatus}"
                                           AutomationProperties.LiveSetting="Polite"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MicrophoneTestDevice}"
                                           IsVisible="{Binding MicrophoneTestDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MicrophoneTestDetail}"
                                           IsVisible="{Binding MicrophoneTestDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Content="{Binding MicrophoneTestButtonText}"
                                    Command="{Binding ToggleMicrophoneTestCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dictation.Language}"
                       Classes="group-title" />
            <Border Classes="settings-panel">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <Grid ColumnDefinitions="*,240"
                              RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Dictation.SpokenLanguage}"
                                       Classes="row-label" />
                            <ComboBox Grid.Column="1"
                                      Grid.Row="0"
                                      AutomationProperties.Name="{loc:Str Dictation.SpokenLanguage}"
                                      ItemsSource="{Binding LanguageChoices}"
                                      SelectedItem="{Binding SelectedLanguageOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpokenLanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding LanguageSelectionWarning}"
                                       IsVisible="{Binding LanguageSelectionRequired}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TwWarningTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource TwFillBrush}"
                            IsVisible="{Binding IsAdditionalLanguagesVisible}" />
                    <Border Grid.Row="2" Classes="row"
                            IsVisible="{Binding IsAdditionalLanguagesVisible}">
                        <Grid ColumnDefinitions="*,240">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.AdditionalLanguages}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.AdditionalLanguagesHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding AdditionalLanguages}"
                                              IsVisible="{Binding HasAdditionalLanguages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpokenLanguageOption">
                                            <Border Classes="chip">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" TextWrapping="Wrap" />
                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                                    <Button Content="‹"
                                                            Classes="chip-remove"
                                                            ToolTip.Tip="{loc:Str Dictation.MoveLanguageEarlier}"
                                                            AutomationProperties.Name="{loc:Str Dictation.MoveLanguageEarlier}"
                                                            Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).MoveAdditionalLanguageEarlierCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                                    <Button Content="›"
                                                            Classes="chip-remove"
                                                            ToolTip.Tip="{loc:Str Dictation.MoveLanguageLater}"
                                                            AutomationProperties.Name="{loc:Str Dictation.MoveLanguageLater}"
                                                            Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).MoveAdditionalLanguageLaterCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                                    <Button Content="×"
                                                            Classes="chip-remove"
                                                            ToolTip.Tip="{loc:Str Dictation.RemoveLanguage}"
                                                            AutomationProperties.Name="{loc:Str Dictation.RemoveLanguage}"
                                                            Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).RemoveAdditionalLanguageCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <ComboBox ItemsSource="{Binding AvailableAdditionalLanguages}"
                                          AutomationProperties.Name="{loc:Str Dictation.AdditionalLanguages}"
                                          SelectedItem="{Binding SelectedAdditionalLanguage}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpokenLanguageOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="{loc:Str Dictation.AddLanguage}"
                                        Command="{Binding AddAdditionalLanguageCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="4"
                            Classes="row">
                        <Grid ColumnDefinitions="*,240">
                            <TextBlock Grid.Column="0" Text="{loc:Str Dictation.TargetLanguage}"
                                       Classes="row-label" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.TargetLanguage}"
                                      ItemsSource="{Binding TranslationTargetOptions}"
                                      SelectedItem="{Binding SelectedTranslationTargetOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TranslationTargetOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" Background="{DynamicResource TwFillBrush}"
                            IsVisible="{Binding IsEnglishOutputVariantVisible}" />
                    <Border Grid.Row="6" Classes="row"
                            IsVisible="{Binding IsEnglishOutputVariantVisible}">
                        <Grid ColumnDefinitions="*,240">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.EnglishOutputVariant}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.EnglishOutputVariantHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.EnglishOutputVariant}"
                                      ItemsSource="{Binding EnglishOutputVariantOptions}"
                                      SelectedItem="{Binding SelectedEnglishOutputVariantOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EnglishOutputVariantOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="7" Background="{DynamicResource TwFillBrush}"
                            IsVisible="{Binding IsGermanOutputVariantVisible}" />
                    <Border Grid.Row="8" Classes="row"
                            IsVisible="{Binding IsGermanOutputVariantVisible}">
                        <Grid ColumnDefinitions="*,240">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.GermanOutputVariant}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.GermanOutputVariantHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{loc:Str Dictation.GermanOutputVariant}"
                                      ItemsSource="{Binding GermanOutputVariantOptions}"
                                      SelectedItem="{Binding SelectedGermanOutputVariantOption}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GermanOutputVariantOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="9" Background="{DynamicResource TwFillBrush}" />
                    <Border Grid.Row="10" Classes="row">
                        <Grid ColumnDefinitions="*,240">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.SpokenFormatting}" Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.SpokenFormattingHint}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SpokenFormattingStrategyOptions}"
                                      AutomationProperties.Name="{loc:Str Dictation.SpokenFormatting}"
                                      SelectedItem="{Binding SelectedSpokenFormattingStrategyOption}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpokenFormattingStrategyOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="11" Background="{DynamicResource TwFillBrush}" IsVisible="{Binding IsSpokenFormattingVerificationVisible}" />
                    <Border Grid.Row="12" Classes="row" IsVisible="{Binding IsSpokenFormattingVerificationVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Str Dictation.SpokenFormattingVerify}" Classes="row-label" />
                            <TextBlock Text="{loc:Str Dictation.SpokenFormattingVerifyHint}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SpokenFormattingProfileStatus}" />
                            <TextBlock Text="{Binding SpokenFormattingProfileContext}" />
                            <TextBlock Text="{loc:Str Dictation.SpokenFormattingVerifyNativeFirst}" TextWrapping="Wrap"
                                       IsVisible="{Binding IsSpokenFormattingVerifyNativeFirstVisible}" />
                            <ItemsControl ItemsSource="{Binding SpokenFormattingScenarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpokenFormattingScenarioRow">
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Spoken}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Expected}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <Button Content="{loc:Str Dictation.SpokenFormattingNativeWorks}" Command="{Binding SpokenFormattingNativeWorksCommand}" Margin="0,0,8,4" />
                                <Button Content="{loc:Str Dictation.SpokenFormattingUseFallback}" Command="{Binding SpokenFormattingUseFallbackCommand}" Margin="0,0,8,4" />
                                <Button Content="{loc:Str Dictation.SpokenFormattingResetOverride}" Command="{Binding SpokenFormattingResetOverrideCommand}"
                                        IsVisible="{Binding HasSpokenFormattingOverride}" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dictation.Settings}"
                       Classes="group-title" />
            <Border Classes="settings-panel">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Str Dictation.AutoPaste}"
                                       Classes="row-label" />
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.AutoPaste}"
                                          IsChecked="{Binding AutoPaste}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            IsVisible="{Binding IsLockPasteToFocusedFieldAvailable}"
                            Background="{DynamicResource TwFillBrush}" />
                    <Border Grid.Row="2"
                            IsVisible="{Binding IsLockPasteToFocusedFieldAvailable}"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.LockPasteToFocusedField}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.LockPasteToFocusedFieldHint}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.LockPasteToFocusedField}"
                                          IsChecked="{Binding LockPasteToFocusedField}"
                                          IsEnabled="{Binding AutoPaste}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="4"
                            Classes="row">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Str Dictation.AppInsertionStrategies}"
                                       Classes="row-label" />

                            <Grid ColumnDefinitions="*,150,Auto"
                                  ColumnSpacing="10">
                                <TextBox Grid.Column="0"
                                         AutomationProperties.Name="{loc:Str Dictation.ProcessNamePlaceholder}"
                                         PlaceholderText="{loc:Str Dictation.ProcessNamePlaceholder}"
                                         Text="{Binding NewInsertionAppProcess}" />
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.InsertionStrategy}"
                                          ItemsSource="{Binding InsertionStrategyOptions}"
                                          SelectedItem="{Binding SelectedNewInsertionStrategyOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InsertionStrategyOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="{loc:Str Common.Add}"
                                        Command="{Binding AddAppInsertionStrategyCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AppInsertionStrategies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppInsertionStrategyRow">
                                        <Grid ColumnDefinitions="*,150,Auto"
                                              ColumnSpacing="10"
                                              Margin="0,2,0,0">
                                            <TextBox Grid.Column="0"
                                                     AutomationProperties.Name="{loc:Str Dictation.ProcessNamePlaceholder}"
                                                     Text="{Binding ProcessName}" />
                                            <ComboBox Grid.Column="1"
                                                      AutomationProperties.Name="{loc:Str Dictation.InsertionStrategy}"
                                                      ItemsSource="{Binding StrategyOptions}"
                                                      SelectedItem="{Binding SelectedStrategyOption}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:InsertionStrategyOption">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                            <Button Grid.Column="2"
                                                    Content="{loc:Str Common.Remove}"
                                                    Command="{Binding $parent[ItemsControl].((vm:DictationSectionViewModel)DataContext).RemoveAppInsertionStrategyCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="5"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="6"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.AutoLearnCorrections}"
                                           Classes="row-label" />
                                <TextBlock
                                    Text="{loc:Str Dictation.AutoLearnCorrectionsHint}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.AutoLearnCorrections}"
                                          IsChecked="{Binding AutoAddDictionaryCorrections}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="7"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="8"
                            Classes="row">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Str Dictation.TargetAppCorrectionLearning}"
                                               Classes="row-label" />
                                    <TextBlock
                                        Text="{loc:Str Dictation.TargetAppCorrectionLearningHint}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="{loc:Str Dictation.TargetAppCorrectionLearning}"
                                              IsChecked="{Binding TargetAppCorrectionLearningEnabled}"
                                              HorizontalAlignment="Right" />
                            </Grid>

                            <!-- The session accessibility flag is off, so Chromium/Electron
                                 and Qt apps won't expose text to correction learning until
                                 the user enables it. -->
                            <Border IsVisible="{Binding ShowAccessibilityBridgeSetup}"
                                    Background="{DynamicResource TwWarningSubtleBrush}"
                                    BorderBrush="{DynamicResource TwWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{loc:Str Dictation.A11yBridgeSetupExplanation}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TwWarningTextBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="{loc:Str Dictation.A11yBridgeEnableButton}"
                                            Command="{Binding EnableAccessibilityBridgeCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- The bridge is on and this app turned it on; offer to remove
                                 it. -->
                            <Border IsVisible="{Binding ShowAccessibilityBridgeRemove}"
                                    Background="{DynamicResource TwFillFaintBrush}"
                                    BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{loc:Str Dictation.A11yBridgeRemoveExplanation}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TwTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <Button Content="{loc:Str Dictation.A11yBridgeRemoveButton}"
                                            Command="{Binding RemoveAccessibilityBridgeCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding AccessibilityBridgeStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TwTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding AccessibilityBridgeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="9"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="10"
                            Classes="row">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,240">
                                <TextBlock Text="{loc:Str Dictation.AutoCleanup}"
                                           Classes="row-label" />
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.AutoCleanup}"
                                          ItemsSource="{Binding CleanupLevelOptions}"
                                          SelectedItem="{Binding SelectedCleanupLevelOption}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CleanupLevelOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <CheckBox IsChecked="{Binding LiveCleanupEnabled}"
                                      IsEnabled="{Binding CanUseLiveCleanup}"
                                      AutomationProperties.Name="{loc:Str Dictation.LiveCleanup}"
                                      Content="{loc:Str Dictation.LiveCleanup}" />
                            <TextBlock Text="{Binding LiveCleanupUnavailableReason}"
                                       IsVisible="{Binding ShowLiveCleanupUnavailableReason}"
                                       FontSize="12" Foreground="{DynamicResource TwWarningTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Str Dictation.LiveCleanupHint}"
                                       FontSize="12" Foreground="{DynamicResource TwTextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="11"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="12"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Str Common.WhisperMode}"
                                       Classes="row-label" />
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Common.WhisperMode}"
                                          IsChecked="{Binding WhisperModeEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="13"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="14"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.SoundFeedback}"
                                           Classes="row-label" />
                                <TextBlock Text="{Binding SoundFeedbackUnavailableReason}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           IsVisible="{Binding ShowSoundFeedbackUnavailableReason}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.SoundFeedback}"
                                          IsChecked="{Binding SoundFeedbackEnabled}"
                                          IsEnabled="{Binding CanUseSoundFeedback}"
                                          ToolTip.Tip="{Binding SoundFeedbackUnavailableReason}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="15"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="16"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Str Dictation.TranscribeShortQuietClips}"
                                       Classes="row-label" />
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.TranscribeShortQuietClips}"
                                          IsChecked="{Binding TranscribeShortQuietClipsAggressively}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="17"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="18"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Str Dictation.AutoStopOnSilence}"
                                       Classes="row-label" />
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.AutoStopOnSilence}"
                                          IsChecked="{Binding SilenceAutoStopEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="19"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="20"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Str Dictation.SilenceTimeoutSeconds}"
                                       Classes="row-label" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.Name="{loc:Str Dictation.SilenceTimeoutSeconds}"
                                     Width="120"
                                     Text="{Binding SilenceAutoStopSeconds}"
                                     HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="21"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="22"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.LiveTranscriptionPreview}"
                                           Classes="row-label" />
                                <TextBlock
                                    Text="{loc:Str Dictation.LiveTranscriptionPreviewHint}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.LiveTranscriptionPreview}"
                                          IsChecked="{Binding LiveTranscriptionEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="23"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="24"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.OnlineBatchLivePreview}"
                                           Classes="row-label" />
                                <TextBlock
                                    Text="{loc:Str Dictation.OnlineBatchLivePreviewHint}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.OnlineBatchLivePreview}"
                                          IsChecked="{Binding OnlineAsrBatchLiveTranscriptionEnabled}"
                                          IsEnabled="{Binding LiveTranscriptionEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="25"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="26"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.RealtimeStreamingLivePreview}"
                                           Classes="row-label" />
                                <TextBlock
                                    Text="{loc:Str Dictation.RealtimeStreamingLivePreviewHint}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.RealtimeStreamingLivePreview}"
                                          IsChecked="{Binding LiveTranscriptionStreamingEnabled}"
                                          IsEnabled="{Binding LiveTranscriptionEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="27"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="28"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.NormalizeNumbers}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.NormalizeNumbersHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.NormalizeNumbers}"
                                          IsChecked="{Binding TranscriptionNumberNormalizationEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="29" Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="30"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.ShortUtterancePunctuation}"
                                           Classes="row-label" />
                                <TextBlock Text="{loc:Str Dictation.ShortUtterancePunctuationHint}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.ShortUtterancePunctuation}"
                                          IsChecked="{Binding ShortUtterancePunctuationEnabled}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str Dictation.SystemAudio}"
                       Classes="group-title" />
            <Border Classes="settings-panel"
                    Margin="0">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto">
                    <Border Grid.Row="0"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.ReduceOtherAudio}"
                                           Classes="row-label" />
                                <TextBlock Text="{Binding AudioDuckingUnavailableReason}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           IsVisible="{Binding ShowAudioDuckingUnavailableReason}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.ReduceOtherAudio}"
                                          IsChecked="{Binding AudioDuckingEnabled}"
                                          IsEnabled="{Binding CanUseAudioDucking}"
                                          ToolTip.Tip="{Binding AudioDuckingUnavailableReason}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="2"
                            Classes="row"
                            IsEnabled="{Binding CanUseAudioDucking}"
                            ToolTip.Tip="{Binding AudioDuckingUnavailableReason}">
                        <StackPanel>
                            <TextBlock Classes="row-label">
                                <Run Text="{loc:Str Dictation.DuckingLevel}" />
                                <Run Text=" " />
                                <Run Text="{Binding AudioDuckingReductionPercent, StringFormat='{}{0:0}%'}" />
                            </TextBlock>
                            <Slider Minimum="20"
                                    AutomationProperties.Name="{loc:Str Dictation.DuckingLevel}"
                                    Maximum="90"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding AudioDuckingReductionPercent}"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource TwFillBrush}" />

                    <Border Grid.Row="4"
                            Classes="row">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Dictation.PauseMediaPlayback}"
                                           Classes="row-label" />
                                <TextBlock Text="{Binding MediaPauseUnavailableReason}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           IsVisible="{Binding ShowMediaPauseUnavailableReason}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          AutomationProperties.Name="{loc:Str Dictation.PauseMediaPlayback}"
                                          IsChecked="{Binding PauseMediaDuringRecording}"
                                          IsEnabled="{Binding CanUseMediaPause}"
                                          ToolTip.Tip="{Binding MediaPauseUnavailableReason}"
                                          HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="{loc:Str Dictation.Recovery}" Classes="group-title" />
            <Border Classes="settings-panel">
                <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Str Dictation.RecoveryRetention}" Classes="row-label" />
                            <TextBlock Text="{loc:Str Dictation.RecoveryRetentionHint}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="80" VerticalAlignment="Center"
                                 AutomationProperties.Name="{loc:Str Dictation.RecoveryRetention}"
                                 Text="{Binding DictationRecoveryRetentionDays}" />
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
