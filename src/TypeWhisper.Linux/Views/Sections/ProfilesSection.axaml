<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.ProfilesSection"
             x:DataType="vm:ProfilesSectionViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.panel-title">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="Foreground" Value="#8A9AAE" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7D8796" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.row-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D6DEE9" />
        </Style>
        <Style Selector="Border.section-panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#1B2430" />
            <Setter Property="BorderBrush" Value="#223243" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.chip-remove">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#8A9AAE" />
        </Style>
        <Style Selector="Border.profile-tile">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#223243" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="ListBox.profile-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.profile-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.profile-list ListBoxItem:selected Border.profile-tile">
            <Setter Property="Background" Value="#203347" />
            <Setter Property="BorderBrush" Value="#305478" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24"
          ColumnDefinitions="260,18,*">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*,Auto">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{loc:Str Profiles.Title}"
                           Classes="panel-title" />
                <TextBlock Text="{Binding Summary}"
                           Classes="page-subtitle" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Classes="profile-list"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     Margin="0,6,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Profile">
                        <Border Classes="profile-tile">
                            <Grid ColumnDefinitions="4,*,Auto"
                                  ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Background="#2196F3"
                                        CornerRadius="2"
                                        Margin="0,2,0,2" />
                                <StackPanel Grid.Column="1"
                                            Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                               Foreground="#8A9AAE">
                                        <Run Text="{Binding ProcessNames.Count, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Profiles.AppRulesCount}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding UrlPatterns.Count, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Profiles.UrlRulesCount}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding $parent[ListBox].((vm:ProfilesSectionViewModel)DataContext).ToggleProfileEnabledCommand}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2"
                    Content="{loc:Str Profiles.NewProfile}"
                    Command="{Binding AddProfileCommand}"
                    Padding="12,8"
                    Margin="0,12,0,0" />
        </Grid>

        <Border Grid.Column="2"
                Classes="section-panel"
                IsVisible="{Binding HasSelectedProfile}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,18,18,18"
                                MaxWidth="940">
                        <Border Background="#FFC371"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,12"
                                IsVisible="{Binding WaylandDetectionWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding WaylandDetectionWarning}"
                                           Foreground="#222"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <Button Grid.Row="1"
                                        Content="{loc:Str Profiles.InstallWindowCallsExtension}"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding CanInstallWindowCallsExtension}"
                                        Command="{Binding InstallWindowCallsExtensionCommand}" />
                            </Grid>
                        </Border>

                        <Border Classes="section-panel"
                                Padding="14,12"
                                Margin="0,0,0,12"
                                IsVisible="{Binding BrowserAccessibilityStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding BrowserAccessibilityStatusMessage}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="{loc:Str Profiles.EnableBrowserUrlDetection}"
                                            IsVisible="{Binding CanEnableBrowserAccessibility}"
                                            Command="{Binding EnableBrowserAccessibilityCommand}" />
                                    <Button Content="{loc:Str Profiles.RevertBrowserUrlDetection}"
                                            IsVisible="{Binding CanRevertBrowserAccessibility}"
                                            Command="{Binding RevertBrowserAccessibilityCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Classes="section-panel"
                                Padding="18,16"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{loc:Str Profiles.Name}"
                                           Classes="field-label" />
                                <TextBox Text="{Binding EditName}"
                                         Margin="0,0,0,14" />

                                <TextBlock
                                    Text="{loc:Str Profiles.NoMatchersHint}"
                                    Classes="page-subtitle"
                                    Margin="0,0,0,14"
                                    IsVisible="{Binding IsGlobalFallbackProfile}" />

                                <TextBlock Text="{loc:Str Profiles.Apps}"
                                           Classes="field-label" />
                                <ItemsControl ItemsSource="{Binding ProcessNameChips}"
                                              Margin="0,0,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="chip">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11" />
                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                                    <Button Content="×"
                                                            Classes="chip-remove"
                                                            Command="{Binding $parent[ItemsControl].((vm:ProfilesSectionViewModel)DataContext).RemoveProcessNameChipCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8"
                                      Margin="0,0,0,8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ProcessNameInput}"
                                             PlaceholderText="{loc:Str Profiles.ProcessNameWatermark}"
                                             KeyDown="OnProcessNameKeyDown" />
                                    <Button Grid.Column="1"
                                            Content="{loc:Str Profiles.CaptureCurrent}"
                                            Command="{Binding CaptureCurrentProcessNameCommand}" />
                                </Grid>
                                <TextBlock
                                    Text="{loc:Str Profiles.ProcessNamesHint}"
                                    Classes="page-subtitle"
                                    Margin="0,0,0,14" />

                                <StackPanel IsVisible="{Binding IsUrlPatternsSectionVisible}">
                                    <TextBlock Text="{loc:Str Profiles.UrlPatterns}"
                                               Classes="field-label" />
                                    <ItemsControl ItemsSource="{Binding UrlPatternChips}"
                                                  Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="chip">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11" />
                                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                                        <Button Content="×"
                                                                Classes="chip-remove"
                                                                Command="{Binding $parent[ItemsControl].((vm:ProfilesSectionViewModel)DataContext).RemoveUrlPatternChipCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,0,0,8">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding UrlPatternInput}"
                                                 PlaceholderText="{loc:Str Profiles.UrlPatternWatermark}"
                                                 KeyDown="OnUrlPatternKeyDown" />
                                        <Button Grid.Column="1"
                                                Content="{loc:Str Profiles.CaptureCurrent}"
                                                Command="{Binding CaptureCurrentUrlPatternCommand}" />
                                    </Grid>
                                    <TextBlock Text="{loc:Str Profiles.UrlPatternsHint}"
                                               Classes="page-subtitle" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:Str Profiles.Overrides}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Classes="section-panel"
                                Margin="0,0,0,18">
                            <Grid RowDefinitions="Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto,1,Auto">
                                <Border Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <TextBlock Text="{loc:Str Profiles.Language}"
                                                   Classes="row-label"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding LanguageChoices}"
                                                  SelectedItem="{Binding EditLanguage}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="#16FFFFFF" />

                                <Border Grid.Row="2" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.Task}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.TaskHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TaskChoices}"
                                                  SelectedItem="{Binding EditTask}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="3" Background="#16FFFFFF" />

                                <Border Grid.Row="4" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.Translation}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.TranslationHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TranslationTargetOptions}"
                                                  SelectedItem="{Binding SelectedTranslationTargetOption}"
                                                  VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:TranslationTargetOption">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="5" Background="#16FFFFFF" />

                                <Border Grid.Row="6" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.Model}"
                                                       Classes="row-label" />
                                            <TextBlock Text="{loc:Str Profiles.ModelHint}"
                                                       Classes="page-subtitle"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ModelOptions}"
                                                  SelectedItem="{Binding SelectedModelOption}"
                                                  DropDownOpened="OnModelDropDownOpened">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileModelOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="7" Background="#16FFFFFF" />

                                <Border Grid.Row="8" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.PromptAction}"
                                                       Classes="row-label" />
                                            <TextBlock Text="{loc:Str Profiles.PromptActionHint}"
                                                       Classes="page-subtitle"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding PromptActionOptions}"
                                                  SelectedItem="{Binding SelectedPromptActionOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PromptActionOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="9" Background="#16FFFFFF" />

                                <Border Grid.Row="10" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Common.WhisperMode}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.WhisperModeHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WhisperModeOptions}"
                                                  SelectedItem="{Binding SelectedWhisperModeOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NullableBooleanOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="11" Background="#16FFFFFF" />

                                <Border Grid.Row="12" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.StylePreset}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.StylePresetHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding StylePresetOptions}"
                                                  SelectedItem="{Binding SelectedStylePresetOption}"
                                                  VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProfileStylePresetOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="13" Background="#16FFFFFF" />

                                <Border Grid.Row="14" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.CleanupOverride}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.CleanupOverrideHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding CleanupOverrideOptions}"
                                                  SelectedItem="{Binding SelectedCleanupOverrideOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NullableCleanupLevelOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="15" Background="#16FFFFFF" />

                                <Border Grid.Row="16" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.DeveloperFormattingOverride}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.DeveloperFormattingOverrideHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <!-- Reuses WhisperModeOptions (NullableBooleanOption list)
                                             because the three choices — inherit / on / off — are
                                             identical in structure to the Whisper Mode override. -->
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WhisperModeOptions}"
                                                  SelectedItem="{Binding SelectedDeveloperFormattingOverrideOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NullableBooleanOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="17" Background="#16FFFFFF" />

                                <Border Grid.Row="18" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.ScreenContextOverride}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.ScreenContextOverrideHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <!-- Reuses WhisperModeOptions (NullableBooleanOption list):
                                             the three choices — inherit / on / off — are identical. -->
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WhisperModeOptions}"
                                                  SelectedItem="{Binding SelectedScreenContextOverrideOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NullableBooleanOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="19" Background="#16FFFFFF" />

                                <Border Grid.Row="20" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.ClipboardContextOverride}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.ClipboardContextOverrideHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WhisperModeOptions}"
                                                  SelectedItem="{Binding SelectedClipboardContextOverrideOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NullableBooleanOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="21" Background="#16FFFFFF" />

                                <Border Grid.Row="22" Padding="18,14">
                                    <Grid ColumnDefinitions="*,150"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.Priority}"
                                                       Classes="row-label" />
                                            <TextBlock Text="{loc:Str Profiles.PriorityHint}"
                                                       Classes="page-subtitle"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <NumericUpDown Grid.Column="1"
                                                       Minimum="0"
                                                       Maximum="999"
                                                       Value="{Binding EditPriority}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="23" Background="#16FFFFFF" />

                                <Border Grid.Row="24" Padding="18,14">
                                    <Grid ColumnDefinitions="*,320"
                                          ColumnSpacing="16">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Profiles.ProfileHotkey}"
                                                       Classes="row-label" />
                                            <TextBlock
                                                Text="{loc:Str Profiles.ProfileHotkeyHint}"
                                                Classes="page-subtitle"
                                                Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBox Text="{Binding EditHotkeyData}"
                                                     PlaceholderText="{loc:Str Profiles.HotkeyWatermark}" />
                                            <ComboBox HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding HotkeyBehaviorOptions}"
                                                      SelectedItem="{Binding SelectedHotkeyBehaviorOption}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProfileHotkeyBehaviorOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Str Profiles.Activation}"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <Border Classes="section-panel"
                                Margin="0,0,0,18">
                            <Border Padding="18,14">
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="14">
                                    <TextBlock Text="{loc:Str Profiles.Enabled}"
                                               Classes="row-label"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding EditIsEnabled}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding EditIsEnabledStatusText}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="#141D26"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1,0,0,0"
                        Padding="18,16">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                          ColumnSpacing="10">
                        <TextBlock Text="{loc:Str Profiles.SaveHint}"
                                   Classes="page-subtitle"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{loc:Str Common.Delete}"
                                Click="OnDeleteProfile"
                                Padding="12,8" />
                        <Button Grid.Column="2"
                                Content="{loc:Str Profiles.OpenLiveContext}"
                                Command="{Binding OpenLiveContextWindowCommand}"
                                Padding="12,8" />
                        <Button Grid.Column="3"
                                Content="{loc:Str Common.Save}"
                                Command="{Binding SaveProfileCommand}"
                                Padding="16,8"
                                Background="#2196F3"
                                BorderBrush="#2196F3"
                                Foreground="White" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Classes="section-panel"
                IsVisible="{Binding HasSelectedProfile, Converter={x:Static local:InverseBoolConverter.Instance}}">
            <Grid>
                <Border Background="#16202B"
                        BorderBrush="#1AFFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20,18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="312">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Profiles.SelectProfile}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Str Profiles.SelectProfileHint}"
                                   Classes="page-subtitle"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>