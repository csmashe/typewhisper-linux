<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:models="using:TypeWhisper.Core.Models"
             x:Class="TypeWhisper.Linux.Views.Sections.HistorySection"
             x:DataType="vm:HistorySectionViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7D8796" />
        </Style>
        <Style Selector="Border.timeline-card">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="13,11" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#1B2430" />
            <Setter Property="BorderBrush" Value="#223243" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="Button.link-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8FC0FF" />
        </Style>
        <Style Selector="Button.card-toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.suggestion-panel">
            <Setter Property="Background" Value="#101820" />
            <Setter Property="BorderBrush" Value="#26384A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28">
        <Grid HorizontalAlignment="Stretch"
              MaxWidth="1080"
              RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Str History.Title}"
                       Classes="section-header" />

            <Grid Margin="0,12,0,8"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{loc:Str History.Search}"
                           Classes="label"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{loc:Str History.App}"
                           Classes="label"
                           Margin="0,0,8,6" />

                <TextBox Grid.Row="1"
                         Grid.Column="0"
                         Text="{Binding SearchQuery}"
                         PlaceholderText="{loc:Str History.SearchPlaceholder}"
                         Margin="0,0,8,0" />

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding AvailableApps}"
                          SelectedItem="{Binding SelectedAppFilter}"
                          Width="160"
                          Margin="0,0,8,0" />

                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="{loc:Str Common.Export}"
                        Click="OnExport"
                        Padding="12,7"
                        Margin="0,0,8,0" />

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Content="{loc:Str History.ClearAll}"
                        Click="OnClearAll"
                        Padding="12,7" />
            </Grid>

            <TextBlock HorizontalAlignment="Right"
                       Foreground="#8A9AAE"
                       FontSize="11.5"
                       Margin="0,0,0,10"
                       Text="{Binding Summary}" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,40,0,0"
                        IsVisible="{Binding IsLoading}">
                <ProgressBar IsIndeterminate="True"
                             Width="160"
                             Height="4" />
                <TextBlock Text="{loc:Str History.Loading}"
                           Foreground="#8A9AAE"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="{loc:Str History.EmptyState}"
                       Foreground="#8A9AAE"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,40,0,0"
                       IsVisible="{Binding ShowEmptyState}" />

            <ScrollViewer Grid.Row="1"
                          x:Name="HistoryScroll"
                          ScrollChanged="OnHistoryScrollChanged"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding ShowTimeline}">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HistoryGroupViewModel">
                            <StackPanel>
                                <Grid Margin="42,14,0,7"
                                      ColumnDefinitions="Auto,*">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#8A9AAE"
                                               Margin="0,0,10,0" />
                                    <Border Grid.Column="1"
                                            Height="1"
                                            Background="#1AFFFFFF"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryRecordRow">
                                            <Grid Margin="0,0,0,1"
                                                  ColumnDefinitions="42,*">
                                                <Grid Grid.Column="0">
                                                    <Border Width="2"
                                                            Background="#1AFFFFFF"
                                                            HorizontalAlignment="Center" />
                                                    <Ellipse Width="10"
                                                             Height="10"
                                                             Fill="#2E8FFF"
                                                             Stroke="#0E1620"
                                                             StrokeThickness="2"
                                                             VerticalAlignment="Top"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,14,0,0" />
                                                </Grid>

                                                <Border Grid.Column="1"
                                                        Classes="timeline-card"
                                                        Margin="0,3,10,3">
                                                    <StackPanel>
                                                        <Button Classes="card-toggle"
                                                                Command="{Binding ToggleExpandCommand}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding TimeLabel}"
                                                                           Foreground="#8A9AAE"
                                                                           FontSize="12"
                                                                           VerticalAlignment="Top"
                                                                           Margin="0,1,10,0" />

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Record.Preview}"
                                                                           FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Top"
                                                                           MaxLines="2" />

                                                                <WrapPanel Grid.Column="2"
                                                                           Orientation="Horizontal"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Top"
                                                                           Margin="8,0,0,0">
                                                                    <Border Classes="badge"
                                                                            IsVisible="{Binding IsSpokenCommand}">
                                                                        <TextBlock Text="{loc:Str History.CommandBadge}"
                                                                                Foreground="#C9A8FF"
                                                                                FontSize="11" />
                                                                    </Border>
                                                                    <Border Classes="badge"
                                                                            IsVisible="{Binding HasProfileName}">
                                                                        <TextBlock Text="{Binding Record.ProfileName}"
                                                                                Foreground="#8FC0FF"
                                                                                FontSize="11" />
                                                                    </Border>
                                                                    <Border Classes="badge"
                                                                            IsVisible="{Binding HasAppProcessName}">
                                                                        <TextBlock
                                                                            Text="{Binding Record.AppProcessName}"
                                                                            Foreground="#8A9AAE"
                                                                            FontSize="11" />
                                                                    </Border>
                                                                    <Border Classes="badge">
                                                                        <TextBlock Text="{Binding DurationLabel}"
                                                                                Foreground="#8A9AAE"
                                                                                FontSize="11" />
                                                                    </Border>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Button>

                                                        <StackPanel IsVisible="{Binding IsExpanded}">
                                                            <Border Height="1"
                                                                    Background="#1AFFFFFF"
                                                                    Margin="0,8,0,7" />

                                                            <TextBlock Text="{Binding Record.FinalText}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13"
                                                                       LineHeight="19"
                                                                       Margin="0,0,0,7"
                                                                       IsVisible="{Binding ShowReadOnlyText}" />

                                                            <StackPanel IsVisible="{Binding ShowEditPanel}">
                                                                <TextBox Text="{Binding EditText}"
                                                                         TextWrapping="Wrap"
                                                                         AcceptsReturn="True"
                                                                         MinHeight="60"
                                                                         MaxHeight="200"
                                                                         Margin="0,0,0,8" />
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="8">
                                                                    <Button Content="{loc:Str Common.Save}"
                                                                            Padding="12,6"
                                                                            Command="{Binding SaveEditCommand}" />
                                                                    <Button Content="{loc:Str Common.Cancel}"
                                                                            Padding="12,6"
                                                                            Command="{Binding CancelEditCommand}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,2,0,4"
                                                                        IsVisible="{Binding ShowExpandedMeta}">
                                                                <TextBlock Foreground="#8A9AAE"
                                                                           FontSize="11">
                                                                    <Run
                                                                        Text="{Binding LocalTimestamp, StringFormat='{}{0:MM/dd/yyyy HH:mm}'}" />
                                                                    <Run Text=" · " />
                                                                    <Run
                                                                        Text="{Binding Record.WordCount, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=History.WordsCount}" />
                                                                </TextBlock>
                                                                <TextBlock Foreground="#8A9AAE"
                                                                           FontSize="11"
                                                                           Margin="8,0,0,0"
                                                                           IsVisible="{Binding HasLanguage}">
                                                                    <Run Text="· " />
                                                                    <Run Text="{Binding Record.Language}" />
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <Border Classes="suggestion-panel"
                                                                    IsVisible="{Binding HasCorrectionSuggestions}">
                                                                <StackPanel Spacing="8">
                                                                    <TextBlock Text="{loc:Str History.SuggestedCorrections}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#D8E6F7" />

                                                                    <ItemsControl
                                                                        ItemsSource="{Binding CorrectionSuggestions}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate
                                                                                x:DataType="vm:CorrectionSuggestionRow">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto,*"
                                                                                    RowDefinitions="Auto,Auto"
                                                                                    ColumnSpacing="8"
                                                                                    Margin="0,0,0,6">
                                                                                    <CheckBox Grid.Row="0"
                                                                                        Grid.Column="0"
                                                                                        Grid.RowSpan="2"
                                                                                        IsChecked="{Binding IsApproved}"
                                                                                        VerticalAlignment="Center" />

                                                                                    <TextBlock Grid.Row="0"
                                                                                        Grid.Column="1"
                                                                                        Text="{loc:Str History.Original}"
                                                                                        Classes="label" />
                                                                                    <TextBlock Grid.Row="0"
                                                                                        Grid.Column="2"
                                                                                        Text="->"
                                                                                        Foreground="#8A9AAE"
                                                                                        VerticalAlignment="Bottom" />
                                                                                    <TextBlock Grid.Row="0"
                                                                                        Grid.Column="3"
                                                                                        Text="{loc:Str History.Replacement}"
                                                                                        Classes="label" />

                                                                                    <TextBox Grid.Row="1"
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Original}"
                                                                                        MinWidth="170" />
                                                                                    <TextBlock Grid.Row="1"
                                                                                        Grid.Column="2"
                                                                                        Text="{Binding ConfidenceLabel}"
                                                                                        Foreground="#8A9AAE"
                                                                                        FontSize="11"
                                                                                        VerticalAlignment="Center" />
                                                                                    <TextBox Grid.Row="1"
                                                                                        Grid.Column="3"
                                                                                        Text="{Binding Replacement}"
                                                                                        MinWidth="170" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <StackPanel Orientation="Horizontal"
                                                                            Spacing="8">
                                                                        <Button Content="{loc:Str History.LearnApproved}"
                                                                                Padding="12,6"
                                                                                Command="{Binding SaveApprovedCorrectionsCommand}" />
                                                                        <Button Content="{loc:Str Common.Dismiss}"
                                                                                Padding="12,6"
                                                                                Command="{Binding DismissCorrectionSuggestionsCommand}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="12"
                                                                        Margin="0,2,0,0"
                                                                        IsVisible="{Binding ShowExpandedActions}">
                                                                <Button Classes="link-button"
                                                                        Content="{loc:Str Common.Edit}"
                                                                        Command="{Binding StartEditCommand}" />
                                                                <Button Classes="link-button"
                                                                        Content="{loc:Str Common.Copy}"
                                                                        Click="OnCopyRecord"
                                                                        Tag="{Binding Record.FinalText}" />
                                                                <Button Classes="link-button"
                                                                        Content="{loc:Str History.AddTerm}"
                                                                        Command="{Binding AddToDictionaryCommand}" />
                                                                <Button Classes="link-button"
                                                                        Content="{loc:Str History.Inspect.Toggle}"
                                                                        Command="{Binding ToggleInspectorCommand}"
                                                                        IsVisible="{Binding ShowInspectorToggle}" />
                                                                <Button Classes="link-button"
                                                                        Content="{Binding PlaybackButtonText}"
                                                                        Command="{Binding TogglePlaybackCommand}"
                                                                        IsVisible="{Binding HasSessionAudio}" />
                                                                <Button Classes="link-button"
                                                                        Content="{loc:Str Common.Delete}"
                                                                        Click="OnDeleteRecord"
                                                                        Tag="{Binding}"
                                                                        Foreground="#F06A6A" />
                                                            </StackPanel>

                                                            <Border Classes="suggestion-panel"
                                                                    IsVisible="{Binding ShowInspector}">
                                                                <StackPanel Spacing="10">
                                                                    <TextBlock Text="{loc:Str History.Inspect.Title}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#D8E6F7" />

                                                                    <StackPanel Spacing="4"
                                                                                IsVisible="{Binding ShowRawVsFinal}">
                                                                        <TextBlock Classes="label">
                                                                            <Run Text="{loc:Str History.Inspect.RawTranscript}" />
                                                                            <Run Text="  →  " />
                                                                            <Run Text="{loc:Str History.Inspect.FinalText}" />
                                                                        </TextBlock>
                                                                        <ItemsControl ItemsSource="{Binding RawVsFinalDiff}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:DiffSegment">
                                                                                    <TextBlock Text="{Binding Text}"
                                                                                               FontSize="13"
                                                                                               Margin="0,0,5,2"
                                                                                               Foreground="{Binding Kind, Converter={x:Static local:DiffKindBrushConverter.Instance}}"
                                                                                               TextDecorations="{Binding Kind, Converter={x:Static local:DiffKindDecorationsConverter.Instance}}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>

                                                                    <ItemsControl ItemsSource="{Binding InspectorCalls}"
                                                                                  IsVisible="{Binding HasLlmCalls}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:LlmCallDisplay">
                                                                                <Border Background="#0C141C"
                                                                                        BorderBrush="#1F2E3D"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6"
                                                                                        Padding="10"
                                                                                        Margin="0,4,0,0">
                                                                                    <StackPanel Spacing="6">
                                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                                            <TextBlock Text="{Binding StageLabel}"
                                                                                                       FontSize="12"
                                                                                                       FontWeight="SemiBold"
                                                                                                       Foreground="#D8E6F7"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <Border Grid.Column="1"
                                                                                                    Classes="badge"
                                                                                                    Background="{Binding RanLocally, Converter={x:Static local:LocalityBadgeBrushConverter.Instance}, ConverterParameter=Background}"
                                                                                                    BorderBrush="{Binding RanLocally, Converter={x:Static local:LocalityBadgeBrushConverter.Instance}, ConverterParameter=Border}">
                                                                                                <TextBlock Text="{Binding NetworkBadgeText}"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{Binding RanLocally, Converter={x:Static local:LocalityBadgeBrushConverter.Instance}, ConverterParameter=Foreground}" />
                                                                                            </Border>
                                                                                        </Grid>

                                                                                        <TextBlock Text="{Binding ProviderModelLabel}"
                                                                                                   FontSize="11"
                                                                                                   Foreground="#8A9AAE" />

                                                                                        <StackPanel Spacing="2"
                                                                                                    IsVisible="{Binding HasSystemPrompt}">
                                                                                            <TextBlock Text="{loc:Str History.Inspect.SystemPrompt}"
                                                                                                       Classes="label" />
                                                                                            <SelectableTextBlock Text="{Binding SystemPromptSent}"
                                                                                                                 FontSize="12"
                                                                                                                 TextWrapping="Wrap"
                                                                                                                 Foreground="#C6D2E0" />
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="2"
                                                                                                    IsVisible="{Binding HasUserPrompt}">
                                                                                            <TextBlock Text="{loc:Str History.Inspect.UserPrompt}"
                                                                                                       Classes="label" />
                                                                                            <SelectableTextBlock Text="{Binding UserPromptSent}"
                                                                                                                 FontSize="12"
                                                                                                                 TextWrapping="Wrap"
                                                                                                                 Foreground="#C6D2E0" />
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="2"
                                                                                                    IsVisible="{Binding HasInjectedContext}">
                                                                                            <TextBlock Text="{loc:Str History.Inspect.InjectedContext}"
                                                                                                       Classes="label" />
                                                                                            <SelectableTextBlock Text="{Binding InjectedMemoryContext}"
                                                                                                                 FontSize="12"
                                                                                                                 TextWrapping="Wrap"
                                                                                                                 Foreground="#C6D2E0" />
                                                                                        </StackPanel>

                                                                                        <StackPanel Spacing="2"
                                                                                                    IsVisible="{Binding HasResponse}">
                                                                                            <TextBlock Text="{loc:Str History.Inspect.Response}"
                                                                                                       Classes="label" />
                                                                                            <SelectableTextBlock Text="{Binding ResponseReceived}"
                                                                                                                 FontSize="12"
                                                                                                                 TextWrapping="Wrap"
                                                                                                                 Foreground="#9FD8B4" />
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <TextBlock Text="{Binding NoLlmCallsMessage}"
                                                                               FontSize="12"
                                                                               Foreground="#8A9AAE"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding !HasLlmCalls}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
