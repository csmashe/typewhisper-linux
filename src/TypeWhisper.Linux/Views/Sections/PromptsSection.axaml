<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.PromptsSection"
             x:DataType="vm:PromptsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="980"
                    Spacing="18">
            <Border Classes="panel"
                    Padding="18,14">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Str Prompts.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="12.5"
                                   Foreground="#9BAABC" />
                        <TextBlock Text="{Binding PromptsHint}"
                                   FontSize="12"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap" />

                        <Border Background="#3A1D1D"
                                BorderBrush="#7A2E2E"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,6,0,0"
                                IsVisible="{Binding HasError}">
                            <TextBlock Text="{Binding ErrorText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#F4A9A9" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{loc:Str Common.New}"
                            Command="{Binding StartCreateCommand}"
                            Padding="18,8"
                            Background="#2196F3"
                            BorderBrush="#2196F3"
                            Foreground="White"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="18,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Str Prompts.CommandModeTitle}"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock Text="{loc:Str Prompts.CommandModeToggle}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Str Prompts.CommandModeHint}"
                                       FontSize="12"
                                       Foreground="#8A9AAE"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding CommandModeEnabled}"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="6"
                                IsEnabled="{Binding CommandModeEnabled}">
                        <TextBlock Text="{loc:Str Prompts.CommandKeyphrase}" />
                        <TextBox Text="{Binding CommandKeyphrase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="{loc:Str Prompts.CommandKeyphrasePlaceholder}" />
                        <TextBlock Text="{loc:Str Prompts.CommandKeyphraseHelp}"
                                   FontSize="12"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{loc:Str Prompts.CommandModel}"
                                   Margin="0,8,0,0" />
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedSpokenCommandProvider}"
                                  HorizontalAlignment="Stretch"
                                  DropDownOpened="OnProviderDropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{loc:Str Prompts.CommandModelHelp}"
                                   FontSize="12"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#4D3B17"
                    BorderBrush="#6E5625"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    IsVisible="{Binding ShowProviderWarning}">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <TextBlock Text="!"
                               FontWeight="Bold"
                               Foreground="#FFD400" />
                    <TextBlock Text="{loc:Str Prompts.NoProvider}"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="{Binding ProviderWarningText}"
                               Foreground="#F3E1AF" />
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <Grid>
                    <StackPanel IsVisible="{Binding ShowEmptyState}">
                        <TextBlock Text="{loc:Str Prompts.EmptyState}"
                                   HorizontalAlignment="Center"
                                   Margin="0,70,0,8"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <Button Content="{loc:Str Common.New}"
                                Command="{Binding StartCreateCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,70"
                                Background="#2196F3"
                                BorderBrush="#2196F3"
                                Foreground="White" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Actions}"
                                  IsVisible="{Binding ShowEmptyState, Converter={x:Static local:InverseBoolConverter.Instance}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PromptAction">
                                <Border Padding="16,14"
                                        BorderBrush="#1AFFFFFF"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="14">
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="10"
                                                Background="#1B2B4B"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Icon}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="17" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold" />
                                                <Border Classes="badge"
                                                        Background="#1A3453"
                                                        BorderBrush="#2E5B89"
                                                        BorderThickness="1">
                                                    <TextBlock
                                                        Text="{Binding IsEnabled, Converter={x:Static loc:LocBoolConverter.Instance}, ConverterParameter='Common.Enabled|Common.Disabled'}"
                                                        FontSize="10.5"
                                                        Foreground="#D6E7FF" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SystemPrompt}"
                                                       FontSize="12.5"
                                                       Foreground="#9BAABC"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                        <Button Grid.Column="2"
                                                Content="{loc:Str Common.Edit}"
                                                Command="{Binding $parent[ItemsControl].((vm:PromptsSectionViewModel)DataContext).EditActionCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Padding="12,6" />
                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                        <ToggleSwitch Grid.Column="3"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      Command="{Binding $parent[ItemsControl].((vm:PromptsSectionViewModel)DataContext).ToggleEnabledCommand}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Classes="panel"
                    Padding="18,16"
                    IsVisible="{Binding ShowEditor}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <TextBlock Grid.ColumnSpan="2"
                               Text="{Binding EditorTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                        <TextBlock Text="{loc:Str Prompts.Name}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditName}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0">
                        <TextBlock Text="{loc:Str Prompts.SystemPrompt}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditSystemPrompt}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="120" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,14,0,0">
                        <TextBlock Text="{loc:Str Prompts.Provider}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedEditProvider}"
                                  DropDownOpened="OnProviderDropDownOpened">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProviderOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,14,0,0">
                        <TextBlock Text="{loc:Str Prompts.ActionPlugin}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ActionPluginOptions}"
                                  SelectedValue="{Binding EditTargetActionPluginId}"
                                  SelectedValueBinding="{Binding Value}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionPluginOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,14,0,0">
                        <TextBlock Text="{loc:Str Prompts.Hotkey}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditHotkeyKey}"
                                 PlaceholderText="{loc:Str Prompts.HotkeyPlaceholder}" />
                        <TextBlock Text="{Binding HotkeyValidationMessage}"
                                   IsVisible="{Binding HotkeyValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="#F3E1AF"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,14,0,0">
                        <TextBlock Text="{loc:Str Prompts.ManualOnly}"
                                   Margin="0,0,0,6" />
                        <ToggleSwitch IsChecked="{Binding EditIsManualOnly}"
                                      OnContent="{loc:Str Prompts.ManualOnlyOn}"
                                      OffContent="{loc:Str Prompts.ManualOnlyOff}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0,18,0,0">
                        <Button Content="{loc:Str Common.Up}"
                                Command="{Binding MoveUpCommand}"
                                CommandParameter="{Binding SelectedAction}"
                                IsVisible="{Binding CanEditExistingAction}" />
                        <Button Content="{loc:Str Common.Down}"
                                Command="{Binding MoveDownCommand}"
                                CommandParameter="{Binding SelectedAction}"
                                IsVisible="{Binding CanEditExistingAction}" />
                        <Button Content="{loc:Str Common.Delete}"
                                Command="{Binding DeleteSelectedActionCommand}"
                                IsVisible="{Binding CanEditExistingAction}" />
                        <Button Content="{loc:Str Common.Cancel}"
                                Command="{Binding CancelEditCommand}" />
                        <Button Content="{loc:Str Common.Save}"
                                Command="{Binding SaveActionCommand}"
                                Background="#2196F3"
                                BorderBrush="#2196F3"
                                Foreground="White" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
