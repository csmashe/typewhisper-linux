<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:models="using:TypeWhisper.Core.Models"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.SnippetsSection"
             x:DataType="vm:SnippetsSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource TwSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style Selector="Button.toolbar-button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="28"
          RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0"
                Classes="panel"
                Padding="18,14"
                Margin="0,0,0,18">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="8">
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="{loc:Str Snippets.Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="12"
                               Foreground="{DynamicResource TwTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock
                        Text="{loc:Str Snippets.PlaceholdersHint}"
                        FontSize="11.5"
                        Foreground="{DynamicResource TwTextSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Str Snippets.EditHint}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TwTextSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <Border Background="{DynamicResource TwErrorSubtleBrush}"
                            BorderBrush="{DynamicResource TwErrorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,10,0,0"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TwErrorTextBrush}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="toolbar-button"
                        Content="{loc:Str Common.Import}"
                        Click="OnImport" />
                <Button Grid.Column="2"
                        Classes="toolbar-button"
                        Content="{loc:Str Common.Export}"
                        Click="OnExport" />
                <Button Grid.Column="3"
                        Classes="toolbar-button"
                        Content="{loc:Str Common.New}"
                        Command="{Binding BeginCreateCommand}"
                        Background="{DynamicResource TwAccentBrush}"
                        BorderBrush="{DynamicResource TwAccentBrush}"
                        Foreground="{DynamicResource TwOnAccentBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="panel"
                Padding="16,14"
                Margin="0,0,0,18"
                IsVisible="{Binding ShowEditor}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0"
                           Text="{Binding EditorTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />

                <Grid Grid.Row="1"
                      ColumnDefinitions="160,*,150"
                      ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             AutomationProperties.Name="{loc:Str Snippets.TriggerPlaceholder}"
                             Text="{Binding NewTrigger}"
                             PlaceholderText="{loc:Str Snippets.TriggerPlaceholder}" />
                    <TextBox Grid.Column="1"
                             AutomationProperties.Name="{loc:Str Snippets.ReplacementPlaceholder}"
                             Text="{Binding NewReplacement}"
                             PlaceholderText="{loc:Str Snippets.ReplacementPlaceholder}" />
                    <ComboBox Grid.Column="2"
                              AutomationProperties.Name="{loc:Str Snippets.TriggerModeLabel}"
                              ItemsSource="{Binding TriggerModeOptions}"
                              SelectedValue="{Binding SelectedTriggerMode}"
                              SelectedValueBinding="{Binding Value}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnippetTriggerModeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*,Auto,Auto"
                      ColumnSpacing="10"
                      Margin="0,10,0,0">
                    <TextBox Grid.Column="0"
                             AutomationProperties.Name="{loc:Str Snippets.TagsPlaceholder}"
                             Text="{Binding NewTags}"
                             PlaceholderText="{loc:Str Snippets.TagsPlaceholder}" />
                    <TextBox Grid.Column="1"
                             AutomationProperties.Name="{loc:Str Snippets.ProfileIdsPlaceholder}"
                             Text="{Binding NewProfileIds}"
                             PlaceholderText="{loc:Str Snippets.ProfileIdsPlaceholder}" />
                    <CheckBox Grid.Column="2"
                              Content="{loc:Str Snippets.CaseSensitive}"
                              IsChecked="{Binding CaseSensitive}"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="{Binding EditorSaveText}"
                                Command="{Binding SaveSnippetCommand}"
                                Background="{DynamicResource TwAccentBrush}"
                                BorderBrush="{DynamicResource TwAccentBrush}"
                                Foreground="{DynamicResource TwOnAccentBrush}"
                                MinWidth="118"
                                Padding="14,8" />
                        <Button Content="{loc:Str Common.Cancel}"
                                Command="{Binding CancelEditCommand}"
                                MinWidth="82"
                                Padding="14,8" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3"
                        Background="{DynamicResource TwSurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource TwBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,12,0,0"
                        IsVisible="{Binding ShowPreview}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{loc:Str Snippets.Preview}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TwTextSecondaryBrush}" />
                        <TextBlock Text="{Binding PreviewText}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TwAccentSubtleTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="{DynamicResource TwWarningSubtleBrush}"
                        BorderBrush="{DynamicResource TwWarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,10,0,0"
                        IsVisible="{Binding HasConflictWarning}">
                    <TextBlock Text="{Binding ConflictWarningText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwWarningTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Classes="panel">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Str Snippets.TagFilter}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TwTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{loc:Str Snippets.TagFilter}"
                                  Width="180"
                                  ItemsSource="{Binding AvailableTags}"
                                  SelectedItem="{Binding SelectedTagFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SnippetTagFilterOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="{loc:Str Snippets.AllTags}"
                                Command="{Binding ClearTagFilterCommand}"
                                IsVisible="{Binding HasSelectedTagFilter}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                IsVisible="{Binding ShowEmptyState}">
                        <TextBlock Text="♪"
                                   FontSize="38"
                                   Foreground="{DynamicResource TwTextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Str Snippets.EmptyTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock
                            Text="{loc:Str Snippets.EmptySubtitle}"
                            FontSize="12.5"
                            Foreground="{DynamicResource TwTextSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18" />
                        <Button Content="{loc:Str Snippets.CreateFirst}"
                                Command="{Binding BeginCreateCommand}"
                                HorizontalAlignment="Center"
                                Padding="16,8"
                                Background="{DynamicResource TwAccentBrush}"
                                BorderBrush="{DynamicResource TwAccentBrush}"
                                Foreground="{DynamicResource TwOnAccentBrush}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding ShowSnippetList}">
                        <ItemsControl ItemsSource="{Binding FilteredSnippets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Snippet">
                                    <Border Padding="16,13"
                                            BorderBrush="{DynamicResource TwBorderSubtleBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                                              ColumnSpacing="14">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource TwAccentSubtleBrush}"
                                                    BorderBrush="{DynamicResource TwBorderAccentSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Trigger}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TwAccentTextBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="->"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TwTextSecondaryBrush}"
                                                       Margin="0,4,0,0" />

                                            <StackPanel Grid.Column="2"
                                                        Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Replacement}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Border Classes="badge"
                                                            IsVisible="{Binding CaseSensitive}">
                                                        <TextBlock Text="Aa"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TwTextPrimaryBrush}" />
                                                    </Border>
                                                    <Border Classes="badge">
                                                        <TextBlock Text="{Binding TriggerMode, Converter={x:Static loc:LocEnumConverter.Instance}, ConverterParameter=Snippets.TriggerMode}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TwTextPrimaryBrush}" />
                                                    </Border>
                                                    <Border Classes="badge">
                                                        <TextBlock Text="{Binding UsageCount, StringFormat='{}{0}x'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TwTextPrimaryBrush}" />
                                                    </Border>
                                                    <Border Classes="badge"
                                                            IsVisible="{Binding Tags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding Tags}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TwTextPrimaryBrush}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                            <Button Grid.Column="3"
                                                    Content="{loc:Str Common.Edit}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SnippetsSectionViewModel)DataContext).BeginEditCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,6"
                                                    VerticalAlignment="Center" />
                                            <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                            <Button Grid.Column="4"
                                                    Content="{loc:Str Common.Delete}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SnippetsSectionViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,6"
                                                    VerticalAlignment="Center" />
                                            <!-- ReSharper disable once Xaml.PossibleNullReferenceException — compiled-binding path is null-safe at runtime; analyzer cannot prove non-null -->
                                            <ToggleSwitch Grid.Column="5"
                                                          AutomationProperties.Name="{Binding Trigger, Converter={x:Static loc:LocFormatConverter.Instance}, ConverterParameter=Snippets.EnabledToggleName}"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding $parent[ItemsControl].((vm:SnippetsSectionViewModel)DataContext).ToggleEnabledCommand}"
                                                          CommandParameter="{Binding}"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>