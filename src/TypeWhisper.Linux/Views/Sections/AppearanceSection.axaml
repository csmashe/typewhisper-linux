<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             x:Class="TypeWhisper.Linux.Views.Sections.AppearanceSection"
             x:DataType="vm:AppearanceSectionViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="980"
                    Spacing="18">
            <TextBlock Text="Overlay layout"
                       Classes="section-title" />

            <Border Classes="panel">
                <Grid RowDefinitions="Auto,1,Auto,1,Auto">
                    <Border Padding="18,14">
                        <Grid ColumnDefinitions="*,320"
                              ColumnSpacing="16">
                            <TextBlock Text="Position"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OverlayPositions}"
                                      SelectedItem="{Binding SelectedOverlayPosition}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlayPositionOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#1AFFFFFF" />

                    <Border Grid.Row="2" Padding="18,14">
                        <Grid ColumnDefinitions="*,320"
                              ColumnSpacing="16">
                            <TextBlock Text="Left content"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OverlayWidgets}"
                                      SelectedItem="{Binding SelectedLeftWidget}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlayWidgetOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#1AFFFFFF" />

                    <Border Grid.Row="4" Padding="18,14">
                        <Grid ColumnDefinitions="*,320"
                              ColumnSpacing="16">
                            <TextBlock Text="Right content"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding OverlayWidgets}"
                                      SelectedItem="{Binding SelectedRightWidget}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OverlayWidgetOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="Preview"
                       Classes="section-title" />

            <!-- Mirrors DictationOverlayWindow's bubble so users see the
                 selected widgets in their real shape and colors. -->
            <Border Classes="panel"
                    Padding="24"
                    Height="220">
                <Border Background="#F0181818"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1"
                        CornerRadius="22"
                        MinWidth="320"
                        Padding="14,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <Ellipse Width="14"
                                 Height="14"
                                 Fill="#1593F5"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding PreviewLeftIsIndicator}" />

                        <StackPanel Orientation="Horizontal"
                                    Spacing="3"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding PreviewLeftIsWaveform}">
                            <Border Width="4" Height="6" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="12" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="18" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="12" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="6" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <TextBlock Text="{Binding PreviewLeftText}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="120"
                                   IsVisible="{Binding PreviewLeftIsText}" />

                        <TextBlock Grid.Column="1"
                                   Text="Recording"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF" />

                        <Ellipse Grid.Column="2"
                                 Width="14"
                                 Height="14"
                                 Fill="#1593F5"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding PreviewRightIsIndicator}" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="3"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding PreviewRightIsWaveform}">
                            <Border Width="4" Height="6" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="12" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="18" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="12" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                            <Border Width="4" Height="6" CornerRadius="999"
                                    Background="#1593F5" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding PreviewRightText}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#99FFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="120"
                                   IsVisible="{Binding PreviewRightIsText}" />
                    </Grid>
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>