<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TypeWhisper.Linux.ViewModels.Sections"
             xmlns:local="using:TypeWhisper.Linux"
             xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.Views.Sections.PluginsSection"
             x:DataType="vm:PluginsSectionViewModel">
    <UserControl.Resources>
        <!-- Shared template used in two places: top-level plugin settings and
             per-item fields inside a plugin collection. -->
        <DataTemplate x:Key="PluginSettingFieldTemplate"
                      x:DataType="vm:PluginSettingFieldRow">
            <StackPanel Spacing="6"
                        Margin="0,0,0,14"
                        IsVisible="{Binding !IsHidden}">
                <TextBlock Text="{Binding Label}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding !IsBooleanKind}" />

                <TextBlock Text="{Binding Description}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="#8A9AAE"
                           IsVisible="{Binding HasDescription}" />

                <ComboBox ItemsSource="{Binding Options}"
                          SelectedItem="{Binding SelectedOption}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsDropdownKind}"
                          DropDownOpened="OnSettingDropDownOpened">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Text="{Binding Value}"
                         PlaceholderText="{Binding Placeholder}"
                         HorizontalAlignment="Stretch"
                         IsVisible="{Binding IsTextKind}" />

                <TextBox Text="{Binding Value}"
                         PlaceholderText="{Binding Placeholder}"
                         PasswordChar="•"
                         HorizontalAlignment="Stretch"
                         IsVisible="{Binding IsSecretKind}" />

                <TextBox Text="{Binding Value}"
                         PlaceholderText="{Binding Placeholder}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         HorizontalAlignment="Stretch"
                         IsVisible="{Binding IsMultilineKind}" />

                <CheckBox IsChecked="{Binding BoolValue}"
                          Content="{Binding Label}"
                          IsVisible="{Binding IsBooleanKind}" />
            </StackPanel>
        </DataTemplate>

        <!-- One category group (title + its plugin cards). Shared between the
             Enabled and Disabled tabs; the row layout below is identical for both. -->
        <DataTemplate x:Key="PluginCategoryGroupTemplate"
                      x:DataType="vm:PluginCategoryGroup">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           Classes="group-title" />

                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginRow">
                            <Border Classes="panel"
                                    Padding="16,14"
                                    Margin="0,0,0,12">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,28"
                                          ColumnSpacing="14">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="10"
                                                Background="#1E88E5"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Monogram}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="5">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{Binding Version, StringFormat='v{0}'}"
                                                    FontSize="11.5"
                                                    Foreground="#8A9AAE"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#8A9AAE"
                                                       IsVisible="{Binding HasDescription}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <Border Classes="badge"
                                                        Background="#1A3453"
                                                        BorderBrush="#2E5B89"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                            FontSize="11"
                                                            Foreground="#D6E7FF" />
                                                </Border>
                                                <Border Classes="badge"
                                                        Background="{Binding LocationBadgeBackground}"
                                                        BorderBrush="{Binding LocationBadgeBorder}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding LocationBadge}"
                                                            FontSize="11"
                                                            Foreground="{Binding LocationBadgeForeground}" />
                                                </Border>
                                                <Border Classes="badge"
                                                        Background="{Binding StatusBadgeBackground}"
                                                        BorderBrush="{Binding StatusBadgeBorder}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding StatusBadge}"
                                                            FontSize="11"
                                                            Foreground="{Binding StatusBadgeForeground}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                        <ToggleSwitch Grid.Column="2"
                                                      Margin="0,0,2,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      Command="{Binding Owner.ToggleEnabledCommand}"
                                                      CommandParameter="{Binding}" />

                                        <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                        <Button Grid.Column="3"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding Owner.ToggleExpandedCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding HasExpandableSettings}">
                                            <TextBlock Text="{Binding ExpansionGlyph}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#D6DEE9" />
                                        </Button>
                                    </Grid>

                                    <Border IsVisible="{Binding IsExpanded}"
                                            Background="#101821"
                                            BorderBrush="#1AFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,14,14,0">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="{Binding Status}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11.5"
                                                       Foreground="#8A9AAE" />

                                            <ItemsControl ItemsSource="{Binding SettingFields}"
                                                          ItemTemplate="{StaticResource PluginSettingFieldTemplate}" />

                                            <ItemsControl ItemsSource="{Binding Collections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="vm:PluginCollectionRow">
                                                        <StackPanel Spacing="10"
                                                                Margin="0,0,0,14">
                                                            <TextBlock Text="{Binding Label}"
                                                                FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}"
                                                                FontSize="11"
                                                                TextWrapping="Wrap"
                                                                Foreground="#8A9AAE"
                                                                IsVisible="{Binding HasDescription}" />

                                                            <ItemsControl
                                                                ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate
                                                                        x:DataType="vm:PluginCollectionItemRow">
                                                                        <Border
                                                                            Background="#17212B"
                                                                            BorderBrush="#1AFFFFFF"
                                                                            BorderThickness="1"
                                                                            CornerRadius="10"
                                                                            Padding="12"
                                                                            Margin="0,0,0,8">
                                                                            <StackPanel Spacing="8">
                                                                                <Grid
                                                                                    ColumnDefinitions="*,Auto,Auto,Auto"
                                                                                    ColumnSpacing="6">
                                                                                    <TextBlock
                                                                                        Grid.Column="0"
                                                                                        Text="{Binding HeaderText}"
                                                                                        FontWeight="SemiBold"
                                                                                        VerticalAlignment="Center" />
                                                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                                                                    <Button
                                                                                        Grid.Column="1"
                                                                                        Content="{loc:Str Common.Up}"
                                                                                        Command="{Binding OwnerCollection.MoveUpCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                                                                    <Button
                                                                                        Grid.Column="2"
                                                                                        Content="{loc:Str Common.Down}"
                                                                                        Command="{Binding OwnerCollection.MoveDownCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                                    <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                                                                    <Button
                                                                                        Grid.Column="3"
                                                                                        Content="{loc:Str Common.Remove}"
                                                                                        Command="{Binding OwnerCollection.RemoveItemCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                                </Grid>

                                                                                <ItemsControl
                                                                                    ItemsSource="{Binding Fields}"
                                                                                    ItemTemplate="{StaticResource PluginSettingFieldTemplate}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Button
                                                                Content="{Binding AddButtonLabel}"
                                                                HorizontalAlignment="Left"
                                                                Command="{Binding AddItemCommand}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Spacing="8"
                                                        Margin="0,0,0,14">
                                                <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                                <Button Content="{loc:Str Common.Save}"
                                                        Command="{Binding Owner.SaveSettingsCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanEditSettings}" />
                                                <!-- ReSharper disable once Xaml.PossibleNullReferenceException (compiled-binding path is null-safe at runtime; analyzer cannot prove non-null) -->
                                                <Button Content="{loc:Str Plugins.Validate}"
                                                        Command="{Binding Owner.ValidateSettingsCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanValidateSettings}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#141D26" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="TextBlock.group-title">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,10" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28"
                    MaxWidth="980"
                    Spacing="16">
            <Border Classes="panel"
                    Padding="18,14">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Str Plugins.Extensions}"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock
                        Text="{loc:Str Plugins.ExtensionsSubtitle}"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        Foreground="#8A9AAE" />
                </StackPanel>
            </Border>

            <Border Classes="panel"
                    Padding="16,14">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetTabCommand}"
                                CommandParameter="0"
                                Background="{Binding IsEnabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#2196F3|False=Transparent'}"
                                BorderBrush="{Binding IsEnabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#2196F3|False=Transparent'}"
                                Foreground="{Binding IsEnabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#FFFFFF|False=#D6DEE9'}"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Content="{Binding EnabledTabLabel}" />
                        <Button Command="{Binding SetTabCommand}"
                                CommandParameter="1"
                                Background="{Binding IsDisabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#2196F3|False=Transparent'}"
                                BorderBrush="{Binding IsDisabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#2196F3|False=Transparent'}"
                                Foreground="{Binding IsDisabledTabSelected, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#FFFFFF|False=#D6DEE9'}"
                                Padding="12,8"
                                Content="{Binding DisabledTabLabel}" />
                    </StackPanel>

                    <Border Background="#17212B"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10">
                        <TextBlock Text="{Binding HeaderSummary}"
                                   FontSize="12.5"
                                   Foreground="#9BAABC" />
                    </Border>

                    <Border Background="#4D3B17"
                            BorderBrush="#6E5625"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10"
                            IsVisible="{Binding HasLoadFailures}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Str Plugins.LoadFailures}"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF0B8" />
                            <ItemsControl ItemsSource="{Binding LoadFailures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginFailureRow">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding FolderName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                            <TextBlock Text="{Binding Message}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E7D8A6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Enabled tab -->
                    <StackPanel IsVisible="{Binding IsEnabledTabSelected}">
                        <ItemsControl ItemsSource="{Binding EnabledGroups}"
                                      IsVisible="{Binding HasEnabledPlugins}"
                                      ItemTemplate="{StaticResource PluginCategoryGroupTemplate}" />
                        <TextBlock Text="{loc:Str Plugins.NoEnabledPlugins}"
                                   FontSize="12.5"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding !HasEnabledPlugins}" />
                    </StackPanel>

                    <!-- Disabled tab -->
                    <StackPanel IsVisible="{Binding IsDisabledTabSelected}">
                        <ItemsControl ItemsSource="{Binding DisabledGroups}"
                                      IsVisible="{Binding HasDisabledPlugins}"
                                      ItemTemplate="{StaticResource PluginCategoryGroupTemplate}" />
                        <TextBlock Text="{loc:Str Plugins.NoDisabledPlugins}"
                                   FontSize="12.5"
                                   Foreground="#8A9AAE"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding !HasDisabledPlugins}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
