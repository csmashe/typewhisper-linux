<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeWhisper.Linux.ViewModels"
        mc:Ignorable="d"
        x:Class="TypeWhisper.Linux.Views.DictationOverlayWindow"
        x:DataType="vm:DictationOverlayViewModel"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        SizeToContent="WidthAndHeight">
    <!-- No Margin: a transparent band around the pill renders as a milky white
         haze on NVIDIA + XWayland (the compositor mis-composites the window's
         clear pixels), so the window hugs the pill exactly. The overlay is
         already inset from the screen edge by PositionOverlay. -->
    <Grid Cursor="SizeAll" IsVisible="{Binding HasVisibleContent}">
        <!-- No BorderBrush: the translucent-white 1px stroke reads as jagged
             white on the rounded caps under NVIDIA + XWayland, where the
             anti-aliased curved edge is mis-composited. The dark fill alone
             gives a clean pill. -->
        <Border Background="#F0181818"
                CornerRadius="22"
                MinWidth="320"
                Padding="14,10"
                IsVisible="{Binding IsOverlayVisible}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="{Binding IndicatorSize}"
                            Height="{Binding IndicatorSize}"
                            CornerRadius="999"
                            Background="#1593F5"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowLeftIndicator}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                Height="18"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowLeftWaveform}">
                        <Border Width="4" Height="{Binding WaveformBar0Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar1Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar2Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar3Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar4Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Text="{Binding LeftText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#99FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120"
                               IsVisible="{Binding ShowLeftText}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CCFFFFFF" />

                    <Border Grid.Column="2"
                            Width="{Binding IndicatorSize}"
                            Height="{Binding IndicatorSize}"
                            CornerRadius="999"
                            Background="#1593F5"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowRightIndicator}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="3"
                                Height="18"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowRightWaveform}">
                        <Border Width="4" Height="{Binding WaveformBar0Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar1Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar2Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar3Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                        <Border Width="4" Height="{Binding WaveformBar4Height}"
                                CornerRadius="999" Background="#1593F5"
                                VerticalAlignment="Bottom" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding RightText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#99FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120"
                               IsVisible="{Binding ShowRightText}" />
                </Grid>

                <ScrollViewer x:Name="PartialPreviewScrollViewer"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding PartialText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding PartialText}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               FontSize="12"
                               Foreground="#E6FFFFFF" />
                </ScrollViewer>

                <ScrollViewer x:Name="LlmResponseScrollViewer"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              IsVisible="{Binding LlmResponseText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding LlmResponseText}"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               FontSize="12"
                               Foreground="#E6FFFFFF" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Background="#F0181818"
                CornerRadius="18"
                Padding="14,7"
                IsVisible="{Binding ShowFeedback}">
            <TextBlock Text="{Binding FeedbackText}"
                       Foreground="{Binding FeedbackForeground}"
                       TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="Center"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
