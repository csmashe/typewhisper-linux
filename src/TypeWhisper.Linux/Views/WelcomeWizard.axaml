<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TypeWhisper.Linux.ViewModels"
        xmlns:vms="using:TypeWhisper.Linux.ViewModels.Sections"
        xmlns:svc="using:TypeWhisper.Linux.Services"
        xmlns:models="using:TypeWhisper.Core.Models"
        xmlns:local="using:TypeWhisper.Linux"
        xmlns:loc="using:TypeWhisper.Linux.Services.Localization"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="720"
        x:Class="TypeWhisper.Linux.Views.WelcomeWizard"
        x:DataType="vm:WelcomeWizardViewModel"
        RequestedThemeVariant="Dark"
        Title="{loc:Str Wizard.WindowTitle}"
        Icon="avares://typewhisper/Resources/typewhisper.ico"
        Width="640" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="0">
        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,32,0,20" Spacing="6">
            <TextBlock Text="TypeWhisper" FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{loc:Str Wizard.Subtitle}" FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- step dots -->
            <ItemsControl Margin="0,10,0,0" HorizontalAlignment="Center"
                          ItemsSource="{Binding StepDots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WelcomeStepDot">
                        <Ellipse Width="24" Height="6"
                                 Fill="{Binding IsActive, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#2196F3|False=#6F7A86'}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StepText}"
                       FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- Content area: TabControl used as a step carousel — the strip is hidden
             below and the visible page is driven by StepIndex -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding StepIndex}" Margin="32,0">
            <TabControl.Styles>
                <!-- Hide the tab strip so only content shows -->
                <Style Selector="TabItem">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </TabControl.Styles>

            <!-- Step 1: pick a model -->
            <TabItem>
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Str Wizard.ChooseModelTitle}"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Str Wizard.ChooseModelDescription}" />
                    <TextBlock Text="{loc:Str Wizard.AllModels}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WizardModelRow">
                                <!-- Explicit colors: the ComboBox dropdown popup resolves theme
                                     DynamicResources against the light variant, so size/Recommended
                                     would render dark-on-dark. Hardcode readable light tones. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#ECECEC" />
                                    <TextBlock Text="{Binding SizeDescription}" FontSize="11"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Str Wizard.RecommendedSuffix}" FontSize="11"
                                               Foreground="#5BA3F5"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsRecommended}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ModelStatus}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding IsModelDownloading}">
                        <ProgressBar Grid.Column="0"
                                     Minimum="0" Maximum="1"
                                     Value="{Binding ModelDownloadProgress}"
                                     Height="6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModelDownloadPercentText}"
                                   FontSize="11" MinWidth="36"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <StackPanel Spacing="6" Margin="0,10,0,0">
                        <TextBlock Text="{loc:Str Wizard.WritingFocus}" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Str Wizard.WritingFocusHint}" />
                        <ComboBox ItemsSource="{Binding IndustryPresets}"
                                  SelectedValueBinding="{Binding Id}"
                                  SelectedValue="{Binding SelectedIndustryPresetId}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:IndustryPreset">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Foreground="#ECECEC" />
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="#9CA3AF"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Step 2: extensions / plugins -->
            <TabItem>
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Str Wizard.ExtensionsTitle}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Str Wizard.ExtensionsDescription}" />
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="0">
                        <ScrollViewer MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding ExtensionPlugins}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vms:PluginRow">
                                        <Border Padding="12,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                              Command="{Binding $parent[ItemsControl].((vm:WelcomeWizardViewModel)DataContext).TogglePluginEnabledCommand}"
                                                              CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Step 3: mic + hotkey -->
            <TabItem>
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Str Wizard.MicAndShortcutTitle}"
                               FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Str Wizard.InputDevice}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Mics}" SelectedItem="{Binding SelectedMic}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:AudioInputDevice">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{loc:Str Wizard.DefaultDeviceSuffix}" FontStyle="Italic"
                                                   IsVisible="{Binding IsDefault}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Str Wizard.ToggleHotkey}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding HotkeyText}" PlaceholderText="Ctrl+Shift+Space" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Str Wizard.HotkeyHint}" />
                        <TextBlock Text="{Binding HotkeyStatus}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Step 4: setup checklist (machine-driven) -->
            <TabItem>
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Str Wizard.SetupSystemTitle}"
                                   FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Str Wizard.Recheck}"
                                Command="{Binding RecheckSetupCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding SetupSummary}"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="0">
                        <ScrollViewer MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding SetupItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SetupTaskRow">
                                        <Border Padding="12,9" BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding StatusGlyph}"
                                                               FontWeight="Bold"
                                                               FontSize="15"
                                                               VerticalAlignment="Top"
                                                               Foreground="{Binding IsSatisfied, Converter={x:Static local:BoolBrushConverter.Instance}, ConverterParameter='True=#4CAF50|False=#E0A030'}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Title}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding RequirementLabel}"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   IsVisible="{Binding HasDetail}"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="4"
                                                                VerticalAlignment="Center"
                                                                MinWidth="90">
                                                        <ProgressBar IsIndeterminate="True"
                                                                     Height="4"
                                                                     IsVisible="{Binding IsBusy}" />
                                                        <Button Content="{Binding ActionLabel}"
                                                                HorizontalAlignment="Stretch"
                                                                IsVisible="{Binding CanRunAction}"
                                                                Command="{Binding $parent[ItemsControl].((vm:WelcomeWizardViewModel)DataContext).RunSetupActionCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Text="{Binding CopyCommand}"
                                                         IsReadOnly="True"
                                                         FontFamily="monospace"
                                                         FontSize="11"
                                                         IsVisible="{Binding HasCopyCommand}" />
                                                <TextBlock Text="{Binding ActionMessage}"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           IsVisible="{Binding HasActionMessage}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{loc:Str Wizard.CudaCheck}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CudaBenchmarkStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{loc:Str Wizard.Run}"
                                    Command="{Binding RunCudaBenchmarkCommand}"
                                    IsEnabled="{Binding CudaBenchmarkButtonEnabled}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Step 5: first dictation check -->
            <TabItem>
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="{loc:Str Wizard.FirstDictationTitle}"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Str Wizard.FirstDictationDescription}" />

                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Str Wizard.Microphone}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding MicTestButtonText}"
                                            Command="{Binding ToggleMicTestCommand}" />
                                </Grid>
                                <ProgressBar Minimum="0"
                                             Maximum="1"
                                             Value="{Binding MicLevel}"
                                             Height="8" />
                                <TextBlock Text="{Binding MicTestStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Str Wizard.Paste}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{loc:Str Wizard.RunPasteTest}"
                                            Click="RunPasteSmokeButton_OnClick" />
                                </Grid>
                                <TextBox x:Name="PasteSmokeBox"
                                         Text="{Binding PasteSmokeText}"
                                         PlaceholderText="{loc:Str Wizard.PasteTestOutputPlaceholder}" />
                                <TextBlock Text="{Binding PasteTestStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Str Wizard.Dictation}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding FirstDictationButtonText}"
                                            Command="{Binding ToggleFirstDictationCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding FirstDictationStatus}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Text="{Binding FirstDictationText}"
                                         IsReadOnly="True"
                                         MinHeight="54"
                                         TextWrapping="Wrap"
                                         PlaceholderText="{loc:Str Wizard.RecognizedTextPlaceholder}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Step 6: done -->
            <TabItem>
                <StackPanel Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str Wizard.YouAreReady}" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding AllRequiredReady}" />
                    <TextBlock Text="{loc:Str Wizard.AlmostThere}" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !AllRequiredReady}" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="480"
                               TextAlignment="Center"
                               IsVisible="{Binding AllRequiredReady}"
                               Text="{loc:Str Wizard.ReadyInstructions}" />

                    <!-- Shown when setup added the user to the input group: the
                         global shortcut only activates after a re-login. -->
                    <Border Background="#3A2F12"
                            BorderBrush="#7A5E1E" BorderThickness="1"
                            CornerRadius="6" Padding="14,12"
                            MaxWidth="480" HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            IsVisible="{Binding ShowReloginNotice}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Str Wizard.ReloginNoticeTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Text="{loc:Str Wizard.ReloginNoticeBody}" />
                        </StackPanel>
                    </Border>

                    <!-- When required setup is incomplete, Finish is disabled.
                         Point the user back to the setup step (or to Skip). -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="14,12"
                            MaxWidth="480"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            IsVisible="{Binding !AllRequiredReady}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SetupSummary}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Str Wizard.IncompleteHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer buttons -->
        <Grid Grid.Row="2" Margin="32,16,32,24" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Content="{loc:Str Common.Back}"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding !IsFirstStep}" />
            <Button Grid.Column="2" Content="{loc:Str Common.Skip}"
                    Command="{Binding SkipCommand}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="{Binding NextLabel}"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding CanAdvance}"
                    Classes="accent" />
        </Grid>
    </Grid>
</Window>