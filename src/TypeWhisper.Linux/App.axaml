<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://typewhisper/Resources/ThemeColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Localize the default ToggleSwitch On/Off labels app-wide.
             Toggles that set their own OnContent/OffContent (a local value)
             override this style, so per-control labels still win. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{loc:Str Common.On}" />
            <Setter Property="OffContent" Value="{loc:Str Common.Off}" />
        </Style>

        <!-- Name the theme's template parts; a screen reader otherwise reads their class name. -->
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton, Slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name" Value="{loc:Str Common.Increase}" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton, Slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name" Value="{loc:Str Common.Decrease}" />
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="AutomationProperties.Name" Value="{Binding $parent[Slider].(AutomationProperties.Name)}" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
        </Style>

        <!-- Segmented tab buttons (Dictionary, Plugins); the selected tab is accent-filled. -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="{DynamicResource TwAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TwOnAccentBrush}" />
        </Style>

        <!-- Compact ToggleSwitch for list tiles, cards, and narrow sidebars
             where "On"/"Off" text takes up too much horizontal space. -->
        <Style Selector="ToggleSwitch.compact">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Standard typography and layout styles for compact list tiles and cards -->
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.card-subtitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Application.Styles>
</Application>
