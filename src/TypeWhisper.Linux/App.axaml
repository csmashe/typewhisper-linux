<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TypeWhisper.Linux.Services.Localization"
             x:Class="TypeWhisper.Linux.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://typewhisper/Resources/ThemeColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Localize the default ToggleSwitch On/Off labels app-wide.
             Toggles that set their own OnContent/OffContent (a local value)
             override this style, so per-control labels still win. -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{loc:Str Common.On}" />
            <Setter Property="OffContent" Value="{loc:Str Common.Off}" />
        </Style>

        <!-- Segmented tab buttons (Dictionary, Plugins); the selected tab is accent-filled. -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TwTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tab.selected">
            <Setter Property="Background" Value="{DynamicResource TwAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TwAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TwOnAccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
