        <!--
            The shared CudaRuntimeProvisioner.cs is <Compile>-linked into BOTH the
            SherpaOnnx and WhisperCpp plugin assemblies, so its public types
            (CudaRuntimeProvisioner, CudaRuntimeProfile) exist in both. Alias the
            SherpaOnnx reference so the WhisperCpp copy is the unambiguous one in the
            global namespace; tests reach SherpaOnnx's own types (and its copy of the
            shared provisioner) via `extern alias SherpaOnnx;`.
        -->
        <ProjectReference Include="..\..\plugins\TypeWhisper.Plugin.SherpaOnnx\TypeWhisper.Plugin.SherpaOnnx.csproj">
            <Aliases>SherpaOnnx</Aliases>
