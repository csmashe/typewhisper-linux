@@ -0,0 +1,11 @@
+// Loads and registers the WebGPU execution provider once for this process.
+#ifndef SHERPA_ONNX_CSRC_WEBGPU_PROVIDER_H_
+#define SHERPA_ONNX_CSRC_WEBGPU_PROVIDER_H_
+
+namespace sherpa_onnx {
+
+bool RegisterWebGpuExecutionProvider();
+
+}  // namespace sherpa_onnx
+
+#endif  // SHERPA_ONNX_CSRC_WEBGPU_PROVIDER_H_
diff --git a/sherpa-onnx/csrc/webgpu-provider.cc b/sherpa-onnx/csrc/webgpu-provider.cc
new file mode 100644
--- /dev/null
+++ b/sherpa-onnx/csrc/webgpu-provider.cc
@@ -0,0 +1,82 @@
+#include "sherpa-onnx/csrc/webgpu-provider.h"
+
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "onnxruntime_cxx_api.h"
+#include "sherpa-onnx/csrc/macros.h"
+
+namespace sherpa_onnx {
+namespace {
+
+#if defined(SHERPA_ONNX_ENABLE_WEBGPU) && SHERPA_ONNX_ENABLE_WEBGPU == 1 && \
+    ORT_API_VERSION >= 24
+
+using Candidate = std::pair<std::basic_string<ORTCHAR_T>, std::string>;
+
+std::vector<Candidate> GetWebGpuLibraryCandidates() {
+  std::vector<Candidate> candidates;
+  const char *path = std::getenv("SHERPA_ONNX_WEBGPU_LIBRARY_PATH");
+  if (path != nullptr && path[0] != '\0') {
+    candidates.emplace_back(path, path);
+  }
+  candidates.emplace_back(ORT_TSTR("libonnxruntime_providers_webgpu.so"),
+                          "libonnxruntime_providers_webgpu.so");
+  return candidates;
+}
+
+bool HasWebGpuDevice(const Ort::Env &env) {
+  for (const auto &device : env.GetEpDevices()) {
+    if (std::string(device.EpName()) == "WebGpuExecutionProvider") {
+      return true;
+    }
+  }
+  return false;
+}
+
+class WebGpuProviderRegistration {
+ public:
+  WebGpuProviderRegistration() : env_(ORT_LOGGING_LEVEL_ERROR, "sherpa-onnx-webgpu") {
+    std::ostringstream errors;
+    for (const auto &candidate : GetWebGpuLibraryCandidates()) {
+      try {
+        env_.RegisterExecutionProviderLibrary("webgpu_ep", candidate.first);
+        if (HasWebGpuDevice(env_)) {
+          registered_ = true;
+          return;
+        }
+        errors << candidate.second << ": no WebGPU device was reported";
+        break;
+      } catch (const Ort::Exception &e) {
+        if (errors.tellp() > 0) errors << "; ";
+        errors << candidate.second << ": " << e.what();
+      }
+    }
+    SHERPA_ONNX_LOGE("WebGPU registration failed: %s", errors.str().c_str());
+  }
+
+  bool IsRegistered() const { return registered_; }
+
+ private:
+  Ort::Env env_;
+  bool registered_ = false;
+};
+
+#endif
+
+}  // namespace
+
+bool RegisterWebGpuExecutionProvider() {
+#if defined(SHERPA_ONNX_ENABLE_WEBGPU) && SHERPA_ONNX_ENABLE_WEBGPU == 1 && \
+    ORT_API_VERSION >= 24
+  static const WebGpuProviderRegistration registration;
+  return registration.IsRegistered();
+#else
+  return false;
+#endif
+}
+
+}  // namespace sherpa_onnx
