<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TypeWhisper.Plugin.OpenAiCompatible</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\TypeWhisper.PluginSDK\TypeWhisper.PluginSDK.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\OpenAi\OpenAiResponsesClient.cs" Link="OpenAi\OpenAiResponsesClient.cs" />
        <Compile Include="..\Shared\OpenAi\OpenAiJson.cs" Link="OpenAi\OpenAiJson.cs" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Localization\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
