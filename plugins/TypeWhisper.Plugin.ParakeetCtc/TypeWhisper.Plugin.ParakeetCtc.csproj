<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\TypeWhisper.PluginSDK\TypeWhisper.PluginSDK.csproj" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.1" />
        <PackageReference Include="SharpCompress" Version="0.48.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\Net\ResilientDownloader.cs"
                 Link="Shared\Net\ResilientDownloader.cs" />
        <Compile Include="..\Shared\Net\DownloadSpace.cs"
                 Link="Shared\Net\DownloadSpace.cs" />
        <Compile Include="..\Shared\Net\InterProcessFileLock.cs"
                 Link="Shared\Net\InterProcessFileLock.cs" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Localization\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
