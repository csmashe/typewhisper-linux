<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TypeWhisper.Plugin.WhisperCpp</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\TypeWhisper.PluginSDK\TypeWhisper.PluginSDK.csproj" />
        <PackageReference Include="Whisper.net" Version="1.8.1" />
        <!--
            CPU runtime only. The NVIDIA CUDA runtime (Whisper.net.Runtime.Cuda.Linux)
            bundles a ~409 MB libggml-cuda-whisper.so; rather than ship it in every
            package, WhisperCudaRuntimeInstaller fetches that exact artifact from
            nuget.org on first CUDA use and caches it. Keep this version in lock-step
            with WhisperCudaRuntimeInstaller.RuntimeVersion.
        -->
        <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared on-demand CUDA provisioner, compiled into the plugin assembly. -->
        <Compile Include="..\Shared\Cuda\CudaRuntimeProvisioner.cs"
                 Link="Shared\Cuda\CudaRuntimeProvisioner.cs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Localization\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
