<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>TypeWhisper.Plugin.SherpaOnnx</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TypeWhisper.PluginSystem.Tests" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\TypeWhisper.PluginSDK\TypeWhisper.PluginSDK.csproj" />
        <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.12.23" />
        <!-- Streams the sherpa-onnx GPU runtime .tar.bz2 (ReaderFactory). -->
        <PackageReference Include="SharpCompress" Version="0.48.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared on-demand CUDA provisioner, compiled into the plugin assembly. -->
        <Compile Include="..\Shared\Cuda\CudaRuntimeProvisioner.cs"
                 Link="Shared\Cuda\CudaRuntimeProvisioner.cs" />
        <!-- Shared resumable/idle-watchdog downloader, compiled into the plugin assembly. -->
        <Compile Include="..\Shared\Net\ResilientDownloader.cs"
                 Link="Shared\Net\ResilientDownloader.cs" />
        <!-- Shared cross-process lock guarding the resumable shared-cache staging files. -->
        <Compile Include="..\Shared\Net\InterProcessFileLock.cs"
                 Link="Shared\Net\InterProcessFileLock.cs" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Localization\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
